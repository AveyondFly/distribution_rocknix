From 3b363afbb8785daa4e1c76fbe29173c96084cff2 Mon Sep 17 00:00:00 2001
From: kk <405437445@qq.com>
Date: Sat, 17 Jan 2026 20:44:51 +0800
Subject: [PATCH 3/3] x

---
 rocknix-joypad.c           | 13 ++++++++++---
 rocknix-singleadc-joypad.c |  6 +++---
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/rocknix-joypad.c b/rocknix-joypad.c
index 7d3c9a0..58ddca1 100644
--- a/rocknix-joypad.c
+++ b/rocknix-joypad.c
@@ -153,7 +153,7 @@ static int pwm_vibrator_start(struct joypad *joypad)
 
 static int joypad_vibrator_start(struct joypad *joypad)
 {
-	if (joypad->rumble_gpio) {
+	if (gpio_is_valid(joypad->rumble_gpio)) {
 		gpio_set_value(joypad->rumble_gpio, 1);
 		return 0;
 	}
@@ -162,7 +162,7 @@ static int joypad_vibrator_start(struct joypad *joypad)
 
 static void pwm_vibrator_stop(struct joypad *joypad)
 {
-	if (joypad->rumble_gpio) {
+	if (gpio_is_valid(joypad->rumble_gpio)) {
 		gpio_set_value(joypad->rumble_gpio, 0);
 		return;
 	}
@@ -563,8 +563,10 @@ static int joypad_rumble_setup(struct device *dev, struct joypad *joypad)
 
 	INIT_WORK(&joypad->play_work, joypad_vibrator_play_work);
 
-	if (joypad->rumble_gpio)
+	if (gpio_is_valid(joypad->rumble_gpio)) {
+		dev_info(dev, "rumble setup with gpio success!\n");
 		return 0;
+	}
 
 	joypad->pwm = devm_pwm_get(dev, "enable");
 	if (IS_ERR(joypad->pwm)) {
@@ -811,6 +813,11 @@ static int joypad_dt_parse(struct device *dev, struct joypad *joypad)
 	if (error)
 		return error;
 
+	joypad->has_rumble =
+		device_property_present(dev, "pwm-names");
+	if (joypad->has_rumble)
+		dev_info(dev, "%s : has rumble\n", __func__);
+
 	joypad->rumble_gpio = of_get_named_gpio_flags(dev->of_node, "rumble-gpio", 0, &flags);
 	if (gpio_is_valid(joypad->rumble_gpio)) {
 		error = devm_gpio_request(dev, joypad->rumble_gpio, "rumble-gpio");
diff --git a/rocknix-singleadc-joypad.c b/rocknix-singleadc-joypad.c
index 7bc3f5d..afe3852 100644
--- a/rocknix-singleadc-joypad.c
+++ b/rocknix-singleadc-joypad.c
@@ -262,7 +262,7 @@ static int pwm_vibrator_start(struct joypad *joypad)
 
 static int joypad_vibrator_start(struct joypad *joypad)
 {
-	if (joypad->rumble_gpio) {
+	if (gpio_is_valid(joypad->rumble_gpio)) {
 		gpio_set_value(joypad->rumble_gpio, 1);
 		return 0;
 	}
@@ -271,7 +271,7 @@ static int joypad_vibrator_start(struct joypad *joypad)
 
 static void pwm_vibrator_stop(struct joypad *joypad)
 {
-	if (joypad->rumble_gpio) {
+	if (gpio_is_valid(joypad->rumble_gpio)) {
 		gpio_set_value(joypad->rumble_gpio, 0);
 		return;
 	}
@@ -859,7 +859,7 @@ static int joypad_rumble_setup(struct device *dev, struct joypad *joypad)
 
 	INIT_WORK(&joypad->play_work, joypad_vibrator_play_work);
 
-	if (joypad->rumble_gpio)
+	if (gpio_is_valid(joypad->rumble_gpio))
 		return 0;
 
 	joypad->pwm = devm_pwm_get(dev, "enable");
