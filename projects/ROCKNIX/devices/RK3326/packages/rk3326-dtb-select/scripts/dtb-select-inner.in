# Run from /flash/dtb-select/ (FAT) or the copy under /usr/share
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
export RK3326_DTB_SELECT_CONFIG="${DIR}/config"
exec /usr/bin/python3 "${DIR}/dtb_selector.py" "$@"
