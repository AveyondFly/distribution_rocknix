From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] devfreq: rockchip: add PX30 DFI and DMC support

Port the PX30 firmware-backed DMC frequency switching path from the
Rockchip BSP. PX30 ATF owns the DDR transition and exposes it through
shared memory plus ROCKCHIP_SIP_DRAM_FREQ; DFI counters provide load data
to devfreq.

Also pass the BSP-compatible DDR electrical timing and de-skew
configuration from the device tree through the second shared-memory page.
Boards without a ddr_timing phandle retain the original behavior.

The ATF interface was verified on RK3326 with firmware ABI 0x106.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
--- a/drivers/devfreq/event/rockchip-dfi.c
+++ b/drivers/devfreq/event/rockchip-dfi.c
@@ -30,6 +30,13 @@
 
 #define DMC_MAX_CHANNELS	4
 
+#define PX30_PMUGRF_OS_REG2		0x208
+#define PX30_PMUGRF_OS_REG3		0x20c
+#define PX30_PMUGRF_OS_REG2_DDRTYPE	GENMASK(15, 13)
+#define PX30_PMUGRF_OS_REG2_BW_CH0	GENMASK(3, 2)
+#define PX30_PMUGRF_OS_REG3_VERSION	GENMASK(31, 28)
+#define PX30_PMUGRF_OS_REG3_DDRTYPE	GENMASK(13, 12)
+
 #define HIWORD_UPDATE(val, mask)	((val) | (mask) << 16)
 
 /* DDRMON_CTRL */
@@ -699,6 +706,29 @@
 	return 0;
 };
 
+static int px30_dfi_init(struct rockchip_dfi *dfi)
+{
+	struct regmap *regmap_pmu = dfi->regmap_pmu;
+	u32 reg2, reg3;
+
+	regmap_read(regmap_pmu, PX30_PMUGRF_OS_REG2, &reg2);
+	regmap_read(regmap_pmu, PX30_PMUGRF_OS_REG3, &reg3);
+
+	dfi->ddr_type = FIELD_GET(PX30_PMUGRF_OS_REG2_DDRTYPE, reg2);
+	if (FIELD_GET(PX30_PMUGRF_OS_REG3_VERSION, reg3) >= 3)
+		dfi->ddr_type |= FIELD_GET(PX30_PMUGRF_OS_REG3_DDRTYPE,
+					   reg3) << 3;
+
+	dfi->channel_mask = BIT(0);
+	dfi->max_channels = 1;
+	dfi->buswidth[0] = FIELD_GET(PX30_PMUGRF_OS_REG2_BW_CH0,
+				       reg2) == 0 ? 4 : 2;
+	dfi->ddrmon_stride = 0;
+	dfi->ddrmon_ctrl_single = true;
+
+	return 0;
+};
+
 static int rk3568_dfi_init(struct rockchip_dfi *dfi)
 {
 	struct regmap *regmap_pmu = dfi->regmap_pmu;
@@ -762,6 +792,7 @@
 };
 
 static const struct of_device_id rockchip_dfi_id_match[] = {
+	{ .compatible = "rockchip,px30-dfi", .data = px30_dfi_init },
 	{ .compatible = "rockchip,rk3399-dfi", .data = rk3399_dfi_init },
 	{ .compatible = "rockchip,rk3568-dfi", .data = rk3568_dfi_init },
 	{ .compatible = "rockchip,rk3588-dfi", .data = rk3588_dfi_init },
