 #define NS_TO_CYCLE(NS, MHz)				(((NS) * (MHz)) / NSEC_PER_USEC)
 
 #define RK3399_SET_ODT_PD_0_SR_IDLE			GENMASK(7, 0)
@@ -37,6 +42,30 @@
 
 #define RK3399_SET_ODT_PD_2_ODT_ENABLE			BIT(0)
 
+#define PX30_SIP_SHARE_MEM				0x82000009
+#define PX30_SHARE_PAGE_TYPE_DDR			2
+#define PX30_SIP_CONFIG_DRAM_GET_VERSION		0x08
+#define PX30_SIP_RET_SET_RATE_TIMEOUT			(-6)
+#define PX30_DMC_MIN_ATF_VERSION			0x103
+
+struct px30_ddr_share_params {
+	u32 hz;
+	u32 lcdc_type;
+	u32 vop;
+	u32 vop_dclk_mode;
+	u32 sr_idle_en;
+	u32 addr_mcu_el3;
+	u32 wait_flag1;
+	u32 wait_flag0;
+	u32 complt_hwirq;
+	u32 update_drv_odt_cfg;
+	u32 update_deskew_cfg;
+};
+
+struct rk3399_dmcfreq_soc_data {
+	bool is_px30;
+};
+
 struct rk3399_dmcfreq {
 	struct device *dev;
 	struct devfreq *devfreq;
@@ -65,8 +94,256 @@
 	unsigned int sr_mc_gate_idle_dis_freq;
 	unsigned int srpd_lite_idle_dis_freq;
 	unsigned int standby_idle_dis_freq;
+
+	bool is_px30;
+	void __iomem *px30_share_mem;
+	struct px30_ddr_share_params __iomem *px30_params;
+	struct completion px30_complete;
+	int px30_complete_irq;
 };
 
+static void px30_dmcfreq_smc(u32 arg0, u32 arg1, u32 command,
+			     struct arm_smccc_res *res)
+{
+	arm_smccc_smc(ROCKCHIP_SIP_DRAM_FREQ, arg0, arg1, command,
+		      0, 0, 0, 0, res);
+}
+
+static irqreturn_t px30_dmcfreq_complete_irq(int irq, void *data)
+{
+	struct rk3399_dmcfreq *dmcfreq = data;
+
+	complete(&dmcfreq->px30_complete);
+	return IRQ_HANDLED;
+}
+
+static int px30_dmcfreq_read_u32_array(struct device *dev,
+				       struct device_node *np,
+				       const char * const *properties,
+				       size_t count, u32 *values)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		ret = of_property_read_u32(np, properties[i], &values[i]);
+		if (ret) {
+			dev_err(dev, "missing DDR timing property %s\n",
+				properties[i]);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static void
+px30_dmcfreq_pack_de_skew(const struct rk3328_ddr_de_skew_setting *de_skew,
+			  struct px30_ddr_dts_config_timing *timing)
+{
+	u32 offset, shift;
+	size_t i;
+
+	memset(timing->ca_skew, 0, sizeof(timing->ca_skew));
+	memset(timing->cs0_skew, 0, sizeof(timing->cs0_skew));
+	memset(timing->cs1_skew, 0, sizeof(timing->cs1_skew));
+
+	for (i = 0; i < ARRAY_SIZE(de_skew->ca_de_skew); i++) {
+		offset = i / 2;
+		shift = i % 2 ? 0 : 4;
+		timing->ca_skew[offset] &= ~(0xf << shift);
+		timing->ca_skew[offset] |= de_skew->ca_de_skew[i] << shift;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(de_skew->cs0_de_skew); i++) {
+		offset = (i / 21) * 11 + (i % 21) / 2;
+		shift = i % 21 == 20 ? 0 : ((i % 21) % 2 ? 0 : 4);
+		timing->cs0_skew[offset] &= ~(0xf << shift);
+		timing->cs0_skew[offset] |= de_skew->cs0_de_skew[i] << shift;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(de_skew->cs1_de_skew); i++) {
+		offset = (i / 21) * 11 + (i % 21) / 2;
+		shift = i % 21 == 20 ? 0 : ((i % 21) % 2 ? 0 : 4);
+		timing->cs1_skew[offset] &= ~(0xf << shift);
+		timing->cs1_skew[offset] |= de_skew->cs1_de_skew[i] << shift;
+	}
+}
+
+static int px30_dmcfreq_load_timings(struct device *dev,
+				     void __iomem *share_mem)
+{
+	struct rk3328_ddr_de_skew_setting *de_skew = NULL;
+	struct px30_ddr_dts_config_timing *timing = NULL;
+	struct device_node *np;
+	int ret = 0;
+
+	BUILD_BUG_ON(sizeof(*timing) > PAGE_SIZE);
+
+	np = of_parse_phandle(dev->of_node, "ddr_timing", 0);
+	if (!np)
+		return 0;
+
+	timing = kzalloc(sizeof(*timing), GFP_KERNEL);
+	de_skew = kzalloc(sizeof(*de_skew), GFP_KERNEL);
+	if (!timing || !de_skew) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = px30_dmcfreq_read_u32_array(dev, np, px30_dts_timing,
+					    ARRAY_SIZE(px30_dts_timing),
+					    (u32 *)timing);
+	if (ret)
+		goto out;
+
+	ret = px30_dmcfreq_read_u32_array(dev, np, rk3328_dts_ca_timing,
+					    ARRAY_SIZE(rk3328_dts_ca_timing),
+					    de_skew->ca_de_skew);
+	if (ret)
+		goto out;
+
+	ret = px30_dmcfreq_read_u32_array(dev, np, rk3328_dts_cs0_timing,
+					    ARRAY_SIZE(rk3328_dts_cs0_timing),
+					    de_skew->cs0_de_skew);
+	if (ret)
+		goto out;
+
+	ret = px30_dmcfreq_read_u32_array(dev, np, rk3328_dts_cs1_timing,
+					    ARRAY_SIZE(rk3328_dts_cs1_timing),
+					    de_skew->cs1_de_skew);
+	if (ret)
+		goto out;
+
+	px30_dmcfreq_pack_de_skew(de_skew, timing);
+	timing->available = 1;
+	memcpy_toio((u8 __iomem *)share_mem + PAGE_SIZE, timing,
+		    sizeof(*timing));
+	/* Publish timing data before ATF consumes the shared memory. */
+	wmb();
+	dev_info(dev, "loaded PX30 DDR timing data from device tree\n");
+
+out:
+	of_node_put(np);
+	kfree(de_skew);
+	kfree(timing);
+
+	return ret;
+}
+
+static int px30_dmcfreq_init(struct platform_device *pdev,
+			     struct rk3399_dmcfreq *dmcfreq)
+{
+	struct device *dev = &pdev->dev;
+	struct irq_data *irq_data;
+	struct arm_smccc_res res;
+	phys_addr_t share_phys;
+	unsigned long atf_version;
+	int ret;
+
+	px30_dmcfreq_smc(0, 0, PX30_SIP_CONFIG_DRAM_GET_VERSION, &res);
+	if (res.a0 || res.a1 < PX30_DMC_MIN_ATF_VERSION)
+		return dev_err_probe(dev, -ENXIO,
+			"DMC requires ATF >= 0x%x (status %ld, version 0x%lx)\n",
+			PX30_DMC_MIN_ATF_VERSION, (long)res.a0, res.a1);
+	atf_version = res.a1;
+
+	arm_smccc_smc(PX30_SIP_SHARE_MEM, 2, PX30_SHARE_PAGE_TYPE_DDR, 0,
+		      0, 0, 0, 0, &res);
+	if (res.a0)
+		return dev_err_probe(dev, (int)res.a0,
+				     "failed to request DMC shared memory\n");
+	share_phys = res.a1;
+	dmcfreq->px30_share_mem = devm_ioremap(dev, share_phys, 2 * PAGE_SIZE);
+	if (!dmcfreq->px30_share_mem)
+		return -ENOMEM;
+	memset_io(dmcfreq->px30_share_mem, 0, 2 * PAGE_SIZE);
+	ret = px30_dmcfreq_load_timings(dev, dmcfreq->px30_share_mem);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "invalid PX30 DDR timing data\n");
+	dmcfreq->px30_params = dmcfreq->px30_share_mem;
+
+	dmcfreq->px30_complete_irq = platform_get_irq_byname(pdev,
+						       "complete_irq");
+	if (dmcfreq->px30_complete_irq < 0)
+		return dmcfreq->px30_complete_irq;
+	init_completion(&dmcfreq->px30_complete);
+	ret = devm_request_irq(dev, dmcfreq->px30_complete_irq,
+			       px30_dmcfreq_complete_irq, 0, dev_name(dev),
+			       dmcfreq);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to request DMC completion IRQ\n");
+	disable_irq(dmcfreq->px30_complete_irq);
+
+	irq_data = irq_get_irq_data(dmcfreq->px30_complete_irq);
+	if (!irq_data)
+		return -EINVAL;
+	writel_relaxed(irqd_to_hwirq(irq_data),
+		       &dmcfreq->px30_params->complt_hwirq);
+
+	px30_dmcfreq_smc(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_INIT, &res);
+	if (res.a0)
+		return dev_err_probe(dev, (int)res.a0,
+				     "ATF DMC initialization failed\n");
+
+	dev_info(dev, "initialized PX30 DMC interface with ATF 0x%lx\n",
+		 atf_version);
+	return 0;
+}
+
+static int px30_dmcfreq_set_rate(struct rk3399_dmcfreq *dmcfreq,
+				 unsigned long rate)
+{
+	struct arm_smccc_res res;
+
+	writel_relaxed(rate, &dmcfreq->px30_params->hz);
+	writel_relaxed(7, &dmcfreq->px30_params->lcdc_type); /* MIPI DSI */
+	writel_relaxed(1, &dmcfreq->px30_params->wait_flag1);
+	writel_relaxed(1, &dmcfreq->px30_params->wait_flag0);
+	/* Publish request parameters before the firmware call. */
+	wmb();
+
+	px30_dmcfreq_smc(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_ROUND_RATE, &res);
+	dev_dbg(dmcfreq->dev,
+		"PX30 DMC rounded %lu Hz to %lu Hz (status %ld)\n",
+		rate, res.a1, res.a0);
+	if (res.a0)
+		return (int)res.a0;
+	rate = res.a1;
+	writel_relaxed(rate, &dmcfreq->px30_params->hz);
+	/* Publish the rounded rate before asking firmware to apply it. */
+	wmb();
+	reinit_completion(&dmcfreq->px30_complete);
+
+	dev_dbg(dmcfreq->dev, "requesting PX30 DMC rate %lu Hz\n", rate);
+	px30_dmcfreq_smc(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_SET_RATE, &res);
+	dev_dbg(dmcfreq->dev, "PX30 DMC SMC returned status %ld, result %d\n",
+		res.a0, (int)res.a1);
+	if ((int)res.a1 == PX30_SIP_RET_SET_RATE_TIMEOUT) {
+		enable_irq(dmcfreq->px30_complete_irq);
+		if (!wait_for_completion_timeout(&dmcfreq->px30_complete,
+					 msecs_to_jiffies(100)))
+			dev_err(dmcfreq->dev,
+				"timed out waiting for DMC frequency change\n");
+		disable_irq(dmcfreq->px30_complete_irq);
+	}
+
+	return (int)res.a0;
+}
+
+static int rk3399_dmcfreq_set_voltage(struct rk3399_dmcfreq *dmcfreq,
+				      unsigned long volt)
+{
+	/* PX30 shares vdd_logic with other consumers which may require more. */
+	return regulator_set_voltage(dmcfreq->vdd_center, volt,
+				     dmcfreq->is_px30 ? INT_MAX : volt);
+}
+
