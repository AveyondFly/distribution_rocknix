From: ROCKNIX <rocknix@rocknix.org>
Subject: [PATCH 1/2] phy: rockchip-inno-usb2: fix RK817 charger detection interference

The BSP USB PHY driver sets EXTCON_USB_HOST and EXTCON_USB_VBUS_EN in host
mode, which causes the otg_switch regulator to output VBUS. This interferes
with RK817 PMIC's external VBUS detection, preventing proper charger
detection when a charger is plugged in.

Fix by:
1. Only set EXTCON_USB_VBUS_EN when vbus regulator is available
2. Don't set EXTCON_USB_HOST/VBUS_EN during initialization if no vbus regulator
3. Properly set iddig_output/iddig_en for host mode

This allows RK817 to correctly detect external chargers while USB host
functionality remains working (VBUS is hardware-connected on affected devices).

Signed-off-by: ROCKNIX <rocknix@rocknix.org>
---
--- a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c	2025-09-01 19:22:35.000000000 +0800
+++ b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c	2026-03-27 14:03:06.320320791 +0800
@@ -1082,7 +1082,7 @@
 		vbus_det_en = true;
 		break;
 	case PHY_MODE_USB_HOST:
-		/* Enable VBUS supply */
+		/* Enable VBUS supply only if vbus regulator is available */
 		ret = rockchip_set_vbus_power(rport, true);
 		if (ret) {
 			dev_err(&rport->phy->dev,
@@ -1090,12 +1090,22 @@
 			return ret;
 		}
 
-		extcon_set_state_sync(rphy->edev, EXTCON_USB_VBUS_EN, true);
+		/*
+		 * Only set VBUS_EN if we have a vbus regulator, otherwise
+		 * it may interfere with external charger detection (e.g. RK817)
+		 */
+		if (rport->vbus)
+			extcon_set_state_sync(rphy->edev, EXTCON_USB_VBUS_EN, true);
 		/* For vbus always on, deinit EXTCON_USB to false. */
 		if (rport->vbus_always_on)
 			extcon_set_state(rphy->edev, EXTCON_USB, false);
 		rport->perip_connected = false;
-		fallthrough;
+		/*
+		 * Keep VBUS detection enabled in host mode to allow
+		 * charger detection when an external charger is connected.
+		 */
+		vbus_det_en = true;
+		break;
 	case PHY_MODE_INVALID:
 		vbus_det_en = false;
 		break;
@@ -1385,8 +1395,30 @@
 			rport->state = OTG_STATE_B_IDLE;
 			sch_work = true;
 		} else {
-			mutex_unlock(&rport->mutex);
-			return;
+			/*
+			 * In host mode, also check for external VBUS (charger)
+			 * and report it via extcon for charging detection.
+			 */
+			if (rport->vbus_attached) {
+				if (rphy->chg_state == USB_CHG_STATE_UNDEFINED) {
+					mutex_unlock(&rport->mutex);
+					kthread_queue_work(rport->chg_worker, &rport->chg_work);
+					return;
+				} else if (rphy->chg_state == USB_CHG_STATE_DETECTED &&
+					   rphy->chg_type == POWER_SUPPLY_TYPE_USB_DCP) {
+					cable = EXTCON_CHG_USB_DCP;
+					sch_work = true;
+				}
+			} else if (cable == EXTCON_CHG_USB_DCP) {
+				cable = EXTCON_NONE;
+				rphy->chg_state = USB_CHG_STATE_UNDEFINED;
+				rphy->chg_type = POWER_SUPPLY_TYPE_UNKNOWN;
+				sch_work = true;
+			}
+			if (!sch_work) {
+				mutex_unlock(&rport->mutex);
+				return;
+			}
 		}
 		break;
 	default:
@@ -1854,10 +1886,13 @@
 	}
 
 	extcon_set_state(rphy->edev, EXTCON_USB_HOST, cable_vbus_state);
-	extcon_set_state(rphy->edev, EXTCON_USB_VBUS_EN, cable_vbus_state);
+	/* Only set VBUS_EN if we have a vbus regulator */
+	if (rport->vbus)
+		extcon_set_state(rphy->edev, EXTCON_USB_VBUS_EN, cable_vbus_state);
 
 	extcon_sync(rphy->edev, EXTCON_USB_HOST);
-	extcon_sync(rphy->edev, EXTCON_USB_VBUS_EN);
+	if (rport->vbus)
+		extcon_sync(rphy->edev, EXTCON_USB_VBUS_EN);
 
 	rockchip_set_vbus_power(rport, cable_vbus_state);
 
@@ -2333,10 +2368,16 @@
 	iddig = property_enabled(rphy->grf, &rport->port_cfg->utmi_id);
 	if (rphy->edev_self && (rport->mode == USB_DR_MODE_HOST ||
 	    rport->mode == USB_DR_MODE_UNKNOWN || !iddig)) {
-		/* Enable VBUS supply for otg port */
-		extcon_set_state(rphy->edev, EXTCON_USB, false);
-		extcon_set_state(rphy->edev, EXTCON_USB_HOST, true);
-		extcon_set_state(rphy->edev, EXTCON_USB_VBUS_EN, true);
+		/*
+		 * Don't set EXTCON_USB_HOST/VBUS_EN to avoid interfering
+		 * with RK817 charger VBUS detection. USB host still works
+		 * without these extcon notifications.
+		 *
+		 * Set iddig_output=0 and iddig_en=1 for host mode to ensure
+		 * proper VBUS detection by external charger (RK817).
+		 */
+		property_enable(base, &rport->port_cfg->iddig_output, false);
+		property_enable(base, &rport->port_cfg->iddig_en, true);
 		ret = rockchip_set_vbus_power(rport, true);
 		if (ret)
 			return ret;
@@ -3507,9 +3548,11 @@
 				extcon_set_state_sync(rphy->edev,
 						      EXTCON_USB_HOST,
 						      !iddig);
-				extcon_set_state_sync(rphy->edev,
-						      EXTCON_USB_VBUS_EN,
-						      !iddig);
+				/* Only set VBUS_EN if we have a vbus regulator */
+				if (rport->vbus)
+					extcon_set_state_sync(rphy->edev,
+							      EXTCON_USB_VBUS_EN,
+							      !iddig);
 				ret = rockchip_set_vbus_power(rport, !iddig);
 				if (ret)
 					return ret;
