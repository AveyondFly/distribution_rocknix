+/*
+ * Select the DAPM-owned RK817 output after a machine-driver jack event.
+ * Playback Path remains a backwards-compatible ALSA control and calls this
+ * helper for its SPK/HP values, so manual amixer overrides work as well.
+ */
+int rk817_codec_set_playback_path(struct snd_soc_component *component,
+				  bool headphone)
+{
+	struct rk817_codec_priv *rk817 = snd_soc_component_get_drvdata(component);
+	struct snd_kcontrol *kcontrol;
+	struct snd_ctl_elem_value ucontrol = {};
+	long target_path = headphone ? HP_PATH : SPK_PATH;
+	int ret;
+
+	kcontrol = snd_soc_card_get_kcontrol(component->card, "Playback Mux");
+	if (!kcontrol)
+		return -ENODEV;
+
+	/*
+	 * Invoke the DAPM control callback rather than updating codec
+	 * registers directly.  Besides selecting the route this stores the
+	 * virtual mux state, allowing amixer to accurately report it.
+	 */
+	ucontrol.value.enumerated.item[0] = headphone ? 0 : 1;
+	rk817->playback_path = target_path;
+	ret = kcontrol->put(kcontrol, &ucontrol);
+	if (ret >= 0) {
+		unsigned int volume = headphone ? rk817->hp_volume :
+						   rk817->spk_volume;
+
+		/*
+		 * The legacy path programmed the board-specific gain whenever
+		 * it selected an output.  DAPM owns the power registers now,
+		 * but retains this non-power gain programming.
+		 */
+		snd_soc_component_write(component, RK817_CODEC_DDAC_VOLL, volume);
+		snd_soc_component_write(component, RK817_CODEC_DDAC_VOLR, volume);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rk817_codec_set_playback_path);
