+/*
+ * Check if we should be in USB host mode.
+ * When utmi_iddig is available, use the hardware/f forced GRF state.
+ * Do not treat stale EXTCON_USB_HOST as host when iddig says device.
+ */
+static bool rockchip_usb2phy_is_host_mode(struct rockchip_usb2phy *rphy,
+					  struct rockchip_usb2phy_port *rport)
+{
+	if (rport->port_cfg->utmi_iddig.enable) {
+		/* PHY reads the ID pin directly */
+		if (!property_enabled(rphy->grf, &rport->port_cfg->iddig_en))
+			return !property_enabled(rphy->grf,
+						 &rport->port_cfg->utmi_iddig);
+
+		/* GRF forces iddig for cold-boot host handoff */
+		return !property_enabled(rphy->grf,
+					 &rport->port_cfg->iddig_output);
+	}
+
+	if (extcon_get_state(rphy->edev, EXTCON_USB_HOST) > 0)
+		return true;
+
+	if (extcon_get_state(rphy->edev, EXTCON_USB_VBUS_EN) > 0)
+		return true;
+
+	return false;
+}
+
+static void rockchip_usb2phy_apply_host_iddig(struct rockchip_usb2phy *rphy,
+					      struct rockchip_usb2phy_port *rport)
+{
+	struct regmap *base = get_reg_base(rphy);
+
+	property_enable(base, &rport->port_cfg->iddig_output, false);
+	property_enable(base, &rport->port_cfg->iddig_en, true);
+}
+
+static void rockchip_usb2phy_clear_host_mode(struct rockchip_usb2phy *rphy,
+					     struct rockchip_usb2phy_port *rport)
+{
+	struct regmap *base = get_reg_base(rphy);
+
+	cancel_delayed_work_sync(&rport->release_iddig_work);
+	property_enable(base, &rport->port_cfg->iddig_en, false);
+	extcon_set_state(rphy->edev, EXTCON_USB_HOST, false);
+	if (rport->vbus)
+		extcon_set_state(rphy->edev, EXTCON_USB_VBUS_EN, false);
+	rockchip_set_vbus_power(rport, false);
+	rport->prev_iddig =
+		property_enabled(rphy->grf, &rport->port_cfg->utmi_iddig);
+}
+
+static void rockchip_usb2phy_release_iddig_work(struct work_struct *work)
+{
+	struct rockchip_usb2phy_port *rport =
+		container_of(work, struct rockchip_usb2phy_port,
+			     release_iddig_work.work);
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(rport->phy->dev.parent);
+	struct regmap *base = get_reg_base(rphy);
+
+	if (!property_enabled(rphy->grf, &rport->port_cfg->iddig_en))
+		return;
+
+	property_enable(base, &rport->port_cfg->iddig_en, false);
+	dev_info(&rport->phy->dev,
+		 "released forced iddig, hardware ID detection active\n");
+	schedule_delayed_work(&rport->otg_sm_work, 0);
+}
+
+static void rockchip_usb2phy_sync_host_from_iddig(struct rockchip_usb2phy *rphy,
+						  struct rockchip_usb2phy_port *rport)
+{
+	if (extcon_get_state(rphy->edev, EXTCON_USB_HOST) > 0 ||
+	    extcon_get_state(rphy->edev, EXTCON_USB_VBUS_EN) > 0)
+		return;
+
+	if (!rport->port_cfg->utmi_iddig.enable ||
+	    property_enabled(rphy->grf, &rport->port_cfg->utmi_iddig))
+		return;
+
+	rockchip_usb2phy_apply_host_iddig(rphy, rport);
+	extcon_set_state(rphy->edev, EXTCON_USB_HOST, true);
+	if (rport->vbus)
+		extcon_set_state(rphy->edev, EXTCON_USB_VBUS_EN, true);
+	rockchip_set_vbus_power(rport, true);
+	rport->prev_iddig = false;
+}
