+static bool dwc2_port_child_ready(struct dwc2_hsotg *hsotg)
+{
+	struct usb_hcd *hcd = dwc2_hsotg_to_hcd(hsotg);
+	struct usb_device *udev;
+
+	if (!hcd || !hcd->self.root_hub)
+		return false;
+
+	udev = usb_hub_find_child(hcd->self.root_hub, 1);
+	return udev && udev->descriptor.bLength;
+}
+
+static void dwc2_kick_cold_boot_port_reset(struct dwc2_hsotg *hsotg)
+{
+	unsigned long flags;
+	u32 hprt0;
+	struct usb_hcd *hcd = dwc2_hsotg_to_hcd(hsotg);
+
+	if (!dwc2_is_host_mode(hsotg))
+		return;
+
+	if (dwc2_port_child_ready(hsotg)) {
+		dev_info(hsotg->dev,
+			 "cold boot: device already enumerated, skip port reset\n");
+		return;
+	}
+
+	dev_info(hsotg->dev, "cold boot: port reset before enumeration\n");
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (hsotg->flags.b.port_connect_status)
+		dwc2_hcd_disconnect(hsotg, true);
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+
+	msleep(50);
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hprt0 = dwc2_read_hprt0(hsotg);
+	if (hprt0 & HPRT0_CONNSTS) {
+		hprt0 |= HPRT0_PWR | HPRT0_RST;
+		dwc2_writel(hsotg, hprt0, HPRT0);
+		spin_unlock_irqrestore(&hsotg->lock, flags);
+		msleep(60);
+		spin_lock_irqsave(&hsotg->lock, flags);
+		hprt0 = dwc2_read_hprt0(hsotg);
+		hprt0 &= ~HPRT0_RST;
+		dwc2_writel(hsotg, hprt0, HPRT0);
+		hsotg->flags.b.port_reset_change = 1;
+		dwc2_hcd_connect(hsotg);
+	}
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+
+	if (hcd)
+		usb_hcd_resume_root_hub(hcd);
+}
+
+static void dwc2_enum_retry_func(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = container_of(work, struct dwc2_hsotg,
+						enum_retry_work.work);
+
+	if (!dwc2_is_host_mode(hsotg))
+		return;
+
+	if (dwc2_port_child_ready(hsotg))
+		return;
+
+	if (hsotg->cold_boot_enum_retries >= 3)
+		return;
+
+	hsotg->cold_boot_enum_retries++;
+	dev_info(hsotg->dev, "cold boot: retry enumeration (%u)\n",
+		 hsotg->cold_boot_enum_retries);
+
+	dwc2_kick_cold_boot_port_reset(hsotg);
+	dwc2_host_start(hsotg);
+
+	schedule_delayed_work(&hsotg->enum_retry_work,
+			      msecs_to_jiffies(5000));
+}
