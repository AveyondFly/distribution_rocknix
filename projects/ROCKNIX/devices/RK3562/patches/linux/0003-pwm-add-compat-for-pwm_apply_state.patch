From: ROCKNIX
Subject: pwm: add compatibility wrapper for pwm_apply_state

The Rockchip BSP kernel uses pwm_apply_might_sleep() instead of
pwm_apply_state(). Add a compatibility macro for drivers expecting
the old API.

diff --git a/include/linux/pwm.h b/include/linux/pwm.h
--- a/include/linux/pwm.h
+++ b/include/linux/pwm.h
@@ -317,6 +317,9 @@ void pwm_get_state(struct pwm_device *pwm, struct pwm_state *state);
 
 int pwm_apply_might_sleep(struct pwm_device *pwm, const struct pwm_state *state);
 
+/* Compatibility for drivers using old API name */
+#define pwm_apply_state pwm_apply_might_sleep
+
 /**
  * pwm_config() - change a PWM device configuration
  * @pwm: PWM device
