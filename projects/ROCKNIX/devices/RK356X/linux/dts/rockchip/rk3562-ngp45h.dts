/dts-v1/;

#include "rk3562.dtsi"
#include "rk3562-linux.dtsi"
#include "rk3562-rk817.dtsi"
#include "rk3562-darkos.dtsi"

/ {
	model = "Xifan NGP45H";
	compatible = "xifan,ngp45h", "rockchip,rk3562-evb1-lp4x-v10",
		     "rockchip,rk3562";

	/*
	 * The inherited SDIO Wi-Fi description is not used on NGP45H and its
	 * control GPIOs overlap the joypad and hp-det.  The production module is
	 * an AIC8800DC USB device powered by the USB-host rail below.
	 */
	wireless-wlan {
		status = "disabled";
	};

	joypad: rocknix-joypad {
		compatible = "rocknix-joypad";
		status = "okay";

		/* Keep the standard ROCKNIX userspace identity. */
		joypad-name = "retrogame_joypad";
		joypad-product = <0x1101>;
		joypad-revision = <0x0100>;
		joypad-vendor = <0x484b>;

		/* Vendor order is LX, LY, RX, RY on SARADC1 channels 4..7. */
		io-channel-names = "key-RY", "key-RX", "key-LY", "key-LX";
		io-channels = <&saradc1 7>, <&saradc1 6>,
			      <&saradc1 5>, <&saradc1 4>;

		pinctrl-names = "default";
		pinctrl-0 = <&ngp45h_gpio_key_pin &ngp45h_rumble_pin>;
		rumble-gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;

		/* Initial values; axis direction and tuning need real-hardware calibration. */
		button-adc-scale = <2>;
		button-adc-deadzone = <216>;
		button-adc-fuzz = <54>;
		button-adc-flat = <54>;
		abs_x-p-tuning = <180>;
		abs_x-n-tuning = <180>;
		abs_y-p-tuning = <180>;
		abs_y-n-tuning = <180>;
		abs_rx-p-tuning = <180>;
		abs_rx-n-tuning = <180>;
		abs_ry-p-tuning = <180>;
		abs_ry-n-tuning = <180>;
		invert-absy;
		invert-absry;
		poll-interval = <10>;

		/* Temporary key map: verify every GPIO and remap on the device. */
		sw1 {
			gpios = <&gpio1 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TR";
			linux,code = <BTN_TR>;
		};
		sw2 {
			gpios = <&gpio1 RK_PD4 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TR2";
			linux,code = <BTN_TR2>;
		};
		sw3 {
			gpios = <&gpio1 RK_PD1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TL";
			linux,code = <BTN_TL>;
		};
		sw4 {
			gpios = <&gpio1 RK_PD2 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TL2";
			linux,code = <BTN_TL2>;
		};
		sw5 {
			gpios = <&gpio0 RK_PC3 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-A";
			linux,code = <BTN_EAST>;
		};
		sw6 {
			gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-B";
			linux,code = <BTN_SOUTH>;
		};
		sw7 {
			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-X";
			linux,code = <BTN_NORTH>;
		};
		sw8 {
			gpios = <&gpio2 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-Y";
			linux,code = <BTN_WEST>;
		};
		sw9 {
			gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};
		sw10 {
			gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};
		sw11 {
			gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};
		sw12 {
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};
		sw13 {
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "BTN_SELECT";
			linux,code = <BTN_SELECT>;
		};
		sw14 {
			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "BTN_START";
			linux,code = <BTN_START>;
		};
		sw15 {
			gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_MODE";
			linux,code = <BTN_MODE>;
		};
		sw16 {
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBL";
			linux,code = <BTN_THUMBL>;
		};
		sw17 {
			gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBR";
			linux,code = <BTN_THUMBR>;
		};
	};

	vcc5v0_usb_host: vcc5v0-usb-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-low;
		gpio = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_pwren_ngp45h>;
	};

	vcc5v0_usb_otg: vcc5v0-usb-otg {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_otg_pwren_ngp45h>;
	};
};

/* ---- Per-device overrides ------------------------------------------------ */

/* NGP45H uses GPIO0_C7 and GPIO1_D2 as gamepad keys, not stick-LED control. */
&led_vcc {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

/*
 * The analogue-stick WS2812 LEDs are connected to SPI0 M1.  The vendor
 * pinctrl only muxes CLK and MOSI; do not use the common spi0m1_pins group,
 * since that would also claim GPIO3_C0 as MISO and conflict with USB power.
 */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m1_csn0_ngp45h &spi0m1_pins_ngp45h>;
	status = "okay";

	spi_dev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

&sdio_pwrseq {
	status = "disabled";
};

/* GPIO0_A5 is a joypad button on NGP45H, not an SD-card power switch. */
&vcc_sd {
	status = "disabled";
};

&sdmmc0 {
	/delete-property/ vmmc-supply;
};

/* Both DW-MMC ports are wired as removable SD-card slots on the vendor DT. */
&sdmmc1 {
	/delete-property/ no-sd;
	/delete-property/ cap-sdio-irq;
	/delete-property/ keep-power-in-suspend;
	/delete-property/ mmc-pwrseq;
	/delete-property/ broken-cd;
	/delete-property/ supports-sdio;
	/delete-property/ supports-rk912;

	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk &sdmmc1_det>;
	status = "okay";
};

/* NGP45H four-key resistor ladder; values are from the running vendor DT. */
&adc_keys {
	/* The vendor mapping intentionally crosses the two volume keycodes. */
	vol-up-key {
		linux,code = <KEY_VOLUMEDOWN>;
		press-threshold-microvolt = <300000>;
	};

	vol-down-key {
		linux,code = <KEY_VOLUMEUP>;
		press-threshold-microvolt = <17000>;
	};

	mute-key {
		linux,code = <KEY_MUTE>;
		label = "menu";
		press-threshold-microvolt = <600000>;
	};

	back-key {
		linux,code = <KEY_ESC>;
		label = "back";
		press-threshold-microvolt = <980000>;
	};
};

/* LCD voltage regulator — GPIO0_B0 active-high enable */
&vcc3v3_lcd_n {
	gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
	enable-active-high;
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_powerctrl_gpio>;
	status = "okay";
};

/* DSI panel — NGP45H 1024x768 landscape panel */
&dsi {
	/* Vendor PHY rate, in Mbps per lane. */
	rockchip,lane-rate = <480>;
};

&dsi_panel {
	bpc = <8>;
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rst_gpio>;
	power-supply = <&vcc3v3_lcd_n>;
	reset-delay-ms = <100>;
	init-delay-ms = <120>;
	enable-delay-ms = <100>;
	prepare-delay-ms = <20>;
	unprepare-delay-ms = <20>;
	disable-delay-ms = <20>;

	panel-init-sequence = [
		15 00 02 ee 01
		15 00 02 ea 07
		15 00 02 eb 12
