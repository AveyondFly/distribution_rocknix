/*
 * Panel dimensions from the NGP45H vendor device tree.
 */
&dsi_panel {
	width-mm = <68>;
	height-mm = <121>;
};

/* Display timing from the NGP45H vendor device tree */
&dsi_timing0 {
	clock-frequency = <52000000>;
	hactive = <1024>;
	vactive = <768>;
	hfront-porch = <32>;
	hsync-len = <20>;
	hback-porch = <20>;
	vfront-porch = <8>;
	vsync-len = <4>;
	vback-porch = <6>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

/* RK817 codec and external speaker amplifier from the vendor tree. */
&rk817_codec {
	hp-volume = <15>;
	spk-volume = <11>;
	spk-ctl-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
	/delete-property/ mic-in-differential;
	/delete-property/ hp2extamplifier;
};

&rk817_sound {
	hp-det-gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&hp_det_ngp45h>;
	/delete-property/ spk-con-gpios;
	/delete-property/ io-channels;
	/delete-property/ io-channel-names;
	/delete-property/ keyup-threshold-microvolt;
	/delete-property/ poll-interval;
	/delete-node/ play-pause-key;
};

/* The common board uses I2C4; NGP45H wires its RK628 to I2C3 instead. */
&i2c4 {
	status = "disabled";
};

&i2c4_rk628 {
	status = "disabled";
};

/* Disconnect the disabled common RK628 endpoint before wiring the I2C3 one. */
&rgb_in_hdmi {
	/delete-property/ remote-endpoint;
};

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;

	i2c3_rk628_ngp45h: rk628@50 {
		compatible = "rockchip,rk628";
		reg = <0x50>;
		status = "okay";
		#sound-dai-cells = <0>;

		assigned-clocks = <&cru CLK_PMU1_WIFI>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_PMU1_WIFI>;
		clock-names = "soc_24M";

		interrupt-parent = <&gpio3>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_HIGH>;
		enable-gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rk628_reset_ngp45h &refclk_pins>;

		rk628-rgb-in;
		rk628-hdmi-out;
		mode-sync-pol = <0>;

		port {
			rk628_rgb_in_ngp45h: endpoint {
				remote-endpoint = <&rgb_out_hdmi>;
			};
		};
	};
};

&rgb_out_hdmi {
	remote-endpoint = <&rk628_rgb_in_ngp45h>;
};

&route_rgb {
	bridge = <&i2c3_rk628_ngp45h>;
};

&rk628_sound {
	status = "okay";

	simple-audio-card,codec {
		sound-dai = <&i2c3_rk628_ngp45h>;
	};
};

/* NGP45H exposes both USB2 controller paths as host ports. */
&u2phy_otg {
	vbus-supply = <&vcc5v0_usb_otg>;
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "host";
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* RK817 PMIC — battery and charger parameters */
&rk817 {
	battery {
		compatible = "rk817,battery";
		ocv_table = <3500 3539 3608 3694 3767 3806 3829 3844
			     3856 3863 3869 3882 3930 4003 4010 4023
			     4033 4045 4059 4070 4171>;
		design_capacity = <3791>;
		design_qmax = <4000>;
		bat_res = <127>;
		design_max_voltage = <4120>;
		sleep_enter_current = <150>;
		sleep_exit_current = <180>;
		sleep_filter_current = <100>;
		power_off_thresd = <3450>;
		zero_algorithm_vol = <3950>;
		max_soc_offset = <60>;
		monitor_sec = <5>;
		sample_res = <10>;
		virtual_power = <0>;
		dc_det_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		charge_red_gpio = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		charge_blue_gpio = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		charge_display_gpio = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
	};

	charger {
		compatible = "rk817,charger";
		min_input_voltage = <4500>;
		max_input_current = <2500>;
		max_chrg_current = <2500>;
		max_chrg_voltage = <4350>;
		chrg_term_mode = <0>;
		chrg_finish_cur = <300>;
		virtual_power = <0>;
		dc_det_adc = <0>;
		dc_det_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		charge_display_gpio = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		extcon = <&u2phy>;
		gate_function_disable = <1>;
	};
};

/* ---- Per-device pinctrl additions ---------------------------------------- */

&pinctrl {
	spi0-ngp45h {
		spi0m1_csn0_ngp45h: spi0m1-csn0-ngp45h {
			rockchip,pins =
				<3 RK_PB7 4 &pcfg_pull_up_drv_level_4>;
		};

		spi0m1_pins_ngp45h: spi0m1-pins-ngp45h {
			rockchip,pins =
				<3 RK_PB5 4 &pcfg_pull_up_drv_level_4>,
				<3 RK_PB4 4 &pcfg_pull_down_drv_level_4>;
		};
	};

	headphone {
		hp_det_ngp45h: hp-det-ngp45h {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	lcd {
		lcd_powerctrl_gpio: lcd-powerctrl-gpio {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb_host_pwren_ngp45h: usb-host-pwren-ngp45h {
			rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb_otg_pwren_ngp45h: usb-otg-pwren-ngp45h {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	rk628-ngp45h {
		rk628_reset_ngp45h: rk628-reset-ngp45h {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	rumble-ngp45h {
		ngp45h_rumble_pin: ngp45h-rumble-pin {
			/* Pull low keeps the active-high motor off before probe. */
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	buttons {
		ngp45h_gpio_key_pin: ngp45h-gpio-key-pin {
			rockchip,pins =
				<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
