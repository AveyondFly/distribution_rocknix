/dts-v1/;

#include "rk3562.dtsi"
#include "rk3562-linux.dtsi"
#include "rk3562-rk817.dtsi"
#include "rk3562-darkos.dtsi"

/ {
	model = "AISLPC RG43H Pro";
	compatible = "aislpc,rg43h-pro", "rockchip,rk3562";

	play_joystick {
		compatible = "play_joystick";
		io-channels = <&saradc0 2>, <&saradc0 3>,
			      <&saradc0 5>, <&saradc0 6>,
			      <&saradc1 1>, <&saradc1 4>,
			      <&saradc1 0>, <&saradc1 2>,
			      <&saradc1 3>, <&saradc1 5>,
			      <&saradc1 6>, <&saradc1 7>;
		io-channel-names = "button0", "button1",
				   "button2", "button3",
				   "l2-abs", "r2-abs",
				   "left-key", "right-key",
				   "down-key", "b-key",
				   "x-key", "y-key";
		joysticks_numbers = <2>;
		left-stick-invert;
		axis-min-value-mv = <250>;
		axis-max-value-mv = <1550>;
		axis-dead-zone-l = <790>;
		axis-dead-zone-h = <1010>;
		axis-division-value = <60>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <16>;
		debounce-interval = <100>;
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_pin &moto_gpio>;
		moto-gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		moto-r-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		gpio-key-num = <10>;
		key-gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD3 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD7 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD4 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
		key-gpios-map = <0x136 0x220 0x137 0x131
				 0x13a 0x13b 0x66  0x13d
				 0x13e>;
		l2-r2-min-value-mv = <50>;
		l2-r2-max-value-mv = <800>;
		l2-r2-division-value-mv = <75>;
		l2_r2_abs;

		left-key {
			label = "left-key";
			adc-chan = <0>;
			linux,code = <0x222>;
			press-threshold-microvolt = <600000>;
		};

		right-key {
			label = "right-key";
			adc-chan = <2>;
			linux,code = <0x223>;
			press-threshold-microvolt = <600000>;
		};

		down-key {
			label = "down-key";
			adc-chan = <3>;
			linux,code = <0x221>;
			press-threshold-microvolt = <600000>;
		};

		b-key {
			label = "b-key";
			adc-chan = <5>;
			linux,code = <0x130>;
			press-threshold-microvolt = <600000>;
		};

		x-key {
			label = "x-key";
			adc-chan = <6>;
			linux,code = <0x133>;
			press-threshold-microvolt = <600000>;
		};

		y-key {
			label = "y-key";
			adc-chan = <7>;
			linux,code = <0x134>;
			press-threshold-microvolt = <600000>;
		};
	};
};

/* ---- Per-device overrides ------------------------------------------------ */

/* DSI panel — 1024x768 landscape init sequence */
&dsi_panel {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rst_gpio &lcd_powerctrl_gpio>;
	enable-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;

	panel-init-sequence = [
		15 00 02 ee 01
		15 00 02 ea 07
