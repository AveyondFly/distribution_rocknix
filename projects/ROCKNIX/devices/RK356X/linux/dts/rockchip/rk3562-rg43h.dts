};

/*
 * 4.3" 1024x768 landscape panel; override darkos.dtsi portrait 68x121.
 * Diagonal 109.2 mm @ 4:3 → 87x66 mm.
 */
&dsi_panel {
	width-mm = <87>;
	height-mm = <66>;
};

/* Display timing — 1024x768 landscape at ~61 Hz */
&dsi_timing0 {
	clock-frequency = <61152000>;
	hactive = <1024>;
	vactive = <768>;
	hfront-porch = <90>;
	hsync-len = <80>;
	hback-porch = <80>;
	vfront-porch = <16>;
	vsync-len = <8>;
	vback-porch = <8>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

/* RK817 codec — RG43H uses higher headphone volume */
&rk817_codec {
	hp-volume = <60>;
};

/* RK817 PMIC — battery and charger parameters */
&rk817 {
	battery {
		compatible = "rk817,battery";
		ocv_table = <3500 3529 3570 3605 3644 3687 3738 3789
			     3823 3847 3871 3903 3926 3957 3999 4027
			     4036 4041 4054 4090 4175>;
		design_capacity = <2906>;
		design_qmax = <3197>;
		bat_res = <102>;
		sleep_enter_current = <300>;
		sleep_exit_current = <300>;
		sleep_filter_current = <100>;
		power_off_thresd = <3500>;
		zero_algorithm_vol = <3850>;
		max_soc_offset = <60>;
		monitor_sec = <5>;
		sample_res = <10>;
		virtual_power = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&charge_led_gpio>;
		charge_red_gpio = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
		charge_green_gpio = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
		moto_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		moto_r_gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
	};

	charger {
		compatible = "rk817,charger";
		min_input_voltage = <4500>;
		max_input_current = <1500>;
		max_chrg_current = <1500>;
		max_chrg_voltage = <4280>;
		chrg_term_mode = <0>;
		chrg_finish_cur = <300>;
		virtual_power = <0>;
		dc_det_adc = <0>;
		otg5v_suspend_enable = <1>;
		extcon = <&u2phy>;
		gate_function_disable = <1>;
	};
};

/* ---- Per-device pinctrl additions ---------------------------------------- */

&pinctrl {
	lcd {
		lcd_powerctrl_gpio: lcd-powerctrl-gpio {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
