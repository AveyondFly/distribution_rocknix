/dts-v1/;

#include "dt-bindings/usb/pd.h"
#include "rk3562.dtsi"
#include "rk3562-linux.dtsi"
#include "rk3562-rk817.dtsi"
#include "rk3562-darkos.dtsi"

/ {
	model = "AISLPC RG52 Mini";
	compatible = "aislpc,rg52mini", "rockchip,rk3562";

	play_joystick {
		compatible = "play_joystick";
		io-channels = <&saradc0 2>, <&saradc0 3>,
			      <&saradc0 5>, <&saradc0 6>,
			      <&saradc1 1>, <&saradc1 4>,
			      <&saradc1 0>, <&saradc1 2>,
			      <&saradc1 3>, <&saradc1 5>,
			      <&saradc1 6>, <&saradc1 7>;
		io-channel-names = "button0", "button1",
				   "button2", "button3",
				   "l2-abs", "r2-abs",
				   "left-key", "right-key",
				   "down-key", "b-key",
				   "x-key", "y-key";
		joysticks_numbers = <2>;
		l_x_swap;
		l_y_swap;
		left-stick-invert;
		axis-min-value-mv = <250>;
		axis-max-value-mv = <1550>;
		axis-dead-zone-l = <790>;
		axis-dead-zone-h = <1010>;
		axis-division-value = <60>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <16>;
		debounce-interval = <100>;
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_pin &moto_gpio>;
		moto-gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		moto-r-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		gpio-key-num = <10>;
		key-gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD3 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD7 GPIO_ACTIVE_LOW>,
			    <&gpio1 RK_PD4 GPIO_ACTIVE_LOW>,
			    <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
		key-gpios-map = <0x136 0x220 0x137 0x131
				 0x13a 0x13b 0x66 0x1d0
				 0x13d 0x13e>;
		l2-r2-min-value-mv = <50>;
		l2-r2-max-value-mv = <800>;
		l2-r2-division-value-mv = <75>;
		l2_r2_abs;

		left-key {
			label = "left-key";
			adc-chan = <0>;
			linux,code = <0x222>;
			press-threshold-microvolt = <80000>;
		};

		right-key {
			label = "right-key";
			adc-chan = <2>;
			linux,code = <0x223>;
			press-threshold-microvolt = <80000>;
		};

		down-key {
			label = "down-key";
			adc-chan = <3>;
			linux,code = <0x221>;
			press-threshold-microvolt = <80000>;
		};

		b-key {
			label = "b-key";
			adc-chan = <5>;
			linux,code = <0x130>;
			press-threshold-microvolt = <80000>;
		};

		x-key {
			label = "x-key";
			adc-chan = <6>;
			linux,code = <0x133>;
			press-threshold-microvolt = <80000>;
		};

		y-key {
			label = "y-key";
			adc-chan = <7>;
			linux,code = <0x134>;
			press-threshold-microvolt = <80000>;
		};
	};
};

/* ---- Chassis fan -------------------------------------------------------- */

/ {
	/* Fan motor rail -- GPIO0_C3 high enables. Marked regulator-boot-on so
	 * the rail is powered before pwm-fan probes; without that the fan-supply
	 * is locked off when pwm-fan tries to spin up. */
	fan_vcc: fan-vcc {
		compatible = "regulator-fixed";
		regulator-name = "fan-vcc";
		pinctrl-names = "default";
		pinctrl-0 = <&fan_vcc_en_gpio>;
		gpios = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/* pwm-fan consumer -- PWM4 channel 0 drives speed; GPIO2_A1 falling
	 * edges are tach pulses; rockchip,temp-trips is a BSP extension that
	 * lets the driver self-manage temp->speed instead of relying on the
	 * thermal-zone cooling-map (CONFIG_ROCKCHIP_SYSTEM_MONITOR path). */
	pwm-fan {
		status = "okay";
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		fan-supply = <&fan_vcc>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_det_gpio>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PA1 IRQ_TYPE_EDGE_FALLING>;
		pwms = <&pwm4 0 50000 0>;
		cooling-levels = <0 50 100 150 200 255>;
		rockchip,temp-trips = <50000 1
				       55000 2
				       60000 3
				       65000 4
				       70000 5>;
	};
};

/* Activate PWM4 channel 0 on the pwm4_m1 route (GPIO1_D1, mux 4) so the
 * pwm-fan consumer above can drive the motor. RG52 Mini-only -- the shared
 * darkos.dtsi leaves &pwm4 disabled. */
&pwm4 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm4m1_pins>;
	status = "okay";
};

/* ---- Per-device overrides ------------------------------------------------ */

/* LCD voltage regulator — GPIO0_B0 active-low enable */
&vcc3v3_lcd_n {
	gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_LOW>;
	enable-active-low;
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_pwren_h>;
	status = "okay";
};

/* DSI panel — 720x1280 portrait init sequence */
&dsi_panel {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rst_gpio>;
	power-supply = <&vcc3v3_lcd_n>;
	rotation = <90>;

	panel-init-sequence = [
		15 00 03 e0 ab ba
		15 00 03 e1 ba ab
		39 00 05 b1 10 01 47 ff
		39 00 07 b2 0a 09 04 50 50 14
		39 00 04 b3 56 52 00
		39 00 04 b4 33 60 04
		39 00 08 b6 b0 00 00 10 00 10 00
		39 00 06 b8 05 12 29 49 48
		39 00 27 b9 7c 70 65 5b 5b 4e 54 3d 56 53 52 6e
		              5a 60 4f 4b 3a 29 06 7c 6f 65 5b 5b
		              4e 54 3d 56 53 52 6e 5a 60 4f 4b 3a
		              29 06
		39 00 11 c0 54 32 23 45 44 44 44 44 40 04 40 04
		              0f 00 00 c1
		39 00 0b c1 33 94 02 87 80 04 92 04 54 00
		39 00 0d c2 73 09 08 89 08 11 22 20 44 bb 18 00
		39 00 17 c3 82 4a 08 23 00 04 06 01 0c 0e 10 12
		              02 02 02 02 02 02 02 02 02 02
		39 00 17 c4 02 0b 09 23 00 05 07 01 0d 0f 11 13
		              02 02 02 02 02 02 02 02 02 02
		39 00 04 c5 83 94 0f
		15 00 03 c6 4c 4c
		39 00 07 c8 11 00 31 42 34 16
		15 00 03 ca cb 43
		39 00 09 cd 0e 64 64 20 14 6b 06 b3
		39 00 05 d2 e3 2b 38 08
		39 00 0c d4 00 01 00 0e 04 44 08 10 00 00 00
		39 00 09 e6 80 01 ff ff ff ff ff ff
		39 00 06 f0 12 03 20 00 ff
		15 00 02 f3 00
		05 78 01 11
		05 1e 01 29
	];
};

/* RK817 codec — RG52 Mini uses higher headphone volume */
&rk817_codec {
	hp-volume = <54>;
};

/* RK817 PMIC — battery and charger parameters */
&rk817 {
	battery {
		compatible = "rk817,battery";
		ocv_table = <3500 3528 3565 3597 3626 3654 3689 3733
			     3776 3812 3845 3876 3910 3952 3990 4015
			     4034 4069 4090 4113 4173>;
		design_capacity = <4654>;
		design_qmax = <5119>;
		bat_res = <78>;
		sleep_enter_current = <300>;
		sleep_exit_current = <300>;
		sleep_filter_current = <100>;
		power_off_thresd = <2800>;
		zero_algorithm_vol = <3850>;
		max_soc_offset = <60>;
		monitor_sec = <5>;
		sample_res = <10>;
		virtual_power = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&charge_led_gpio>;
		charge_red_gpio = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
		charge_green_gpio = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
		moto_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		moto_r_gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
	};

	charger {
		compatible = "rk817,charger";
		min_input_voltage = <4500>;
		max_input_current = <3000>;
		max_chrg_current = <2000>;
		max_chrg_voltage = <4300>;
		chrg_term_mode = <0>;
		chrg_finish_cur = <300>;
		virtual_power = <0>;
		dc_det_adc = <0>;
		otg5v_suspend_enable = <1>;
		extcon = <&usbc0>;
		gate_function_disable = <1>;
	};
};

/* ---- USB Type-C (HUSB311 on I2C2) ---------------------------------------- */

&i2c2 {
	status = "okay";

	usbc0: husb311@4e {
		compatible = "hynetek,husb311";
		reg = <0x4e>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&otg_switch>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_role_switch>;
				};
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos =
				<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
			source-pdos =
				<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
		};
	};
};

&usbdrd_dwc3 {
	/delete-property/ extcon;
	usb-role-switch;

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&u2phy_otg {
	rockchip,vbus-always-on;
};

/* ---- Per-device pinctrl additions ---------------------------------------- */

&pinctrl {
	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	vcc3v3_lcd_n {
		lcd_pwren_h: lcd-pwren-h {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
