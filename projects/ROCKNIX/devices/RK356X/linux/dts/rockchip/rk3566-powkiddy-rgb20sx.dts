#include "rk3566-powkiddy-rk2023.dts"

/ {
	model = "Powkiddy RGB20SX";
	compatible = "powkiddy,rgb20sx", "rockchip,rk3566";

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <60>;

		button-mode {
			label = "MODE";
			linux,code = <BTN_MODE>;
			press-threshold-microvolt = <1750>;
		};
	};
};

&cru {
	assigned-clocks = <&pmucru CLK_RTC_32K>, <&cru PLL_GPLL>,
			  <&pmucru PLL_PPLL>, <&cru PLL_VPLL>;
	assigned-clock-rates = <32768>, <1200000000>,
			       <200000000>, <292500000>;
};

&dsi0 {
	panel: panel@0 {
		compatible = "powkiddy,rgb30-panel";
		reg = <0>;
		backlight = <&backlight>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd0_rst_gpio>;
		reset-gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
		vcc-supply = <&vcc3v3_lcd0_n>;
		iovcc-supply = <&vcc3v3_lcd0_n>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				mipi_in_panel: endpoint {
					remote-endpoint = <&mipi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};
};

&joypad {
	pwms = <&pwm5 0 1000000000 0>;
	pwm-names = "enable";
	rumble-boost-weak = <0x0000>;
	rumble-boost-strong = <0x0000>;
};

&pwm5 {
	status = "okay";
};

&uart1 {
	bluetooth {
		compatible = "realtek,rtl8723ds-bt";
	};
};
