diff --git a/arch/arm/mach-rockchip/resource_img.c b/arch/arm/mach-rockchip/resource_img.c
index 57f939c..2f440f5 100644
--- a/arch/arm/mach-rockchip/resource_img.c
+++ b/arch/arm/mach-rockchip/resource_img.c
@@ -904,9 +904,24 @@ int rockchip_read_resource_dtb(void *fdt_addr, char **hash, int *hash_size)
 	*hash = file->hash;
 	*hash_size = file->hash_size;
 	printf("DTB: %s\n", file->name);
-	char * myfdtfile = strtok(file->name, "#");
-	strncat(myfdtfile,".dtb",4);
-	env_set("fdtfile", myfdtfile);
+	{
+		char fdtfile[128];
+		const char *hashmark = strchr(file->name, '#');
+
+		if (hashmark && hashmark > file->name) {
+			size_t len = hashmark - file->name;
+
+			if (len >= sizeof(fdtfile))
+				len = sizeof(fdtfile) - 5;
+			memcpy(fdtfile, file->name, len);
+			fdtfile[len] = '\0';
+			if (!strstr(fdtfile, ".dtb"))
+				snprintf(fdtfile + len, sizeof(fdtfile) - len, ".dtb");
+		} else {
+			strlcpy(fdtfile, file->name, sizeof(fdtfile));
+		}
+		env_set("fdtfile", fdtfile);
+	}
 
 	return 0;
 }
