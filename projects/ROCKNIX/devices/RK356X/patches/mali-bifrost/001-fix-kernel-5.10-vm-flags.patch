diff -Naur a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_mem_linux.c b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_mem_linux.c
--- a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_mem_linux.c	2026-03-16 02:44:15.000000000 +0800
+++ b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_mem_linux.c	2026-07-03 17:30:33.325512494 +0800
@@ -2553,7 +2553,7 @@
 	 * See MIDBASE-1057
 	 */
 
-	__vm_flags_mod(vma, VM_DONTCOPY | VM_DONTDUMP | VM_DONTEXPAND | VM_IO, 0);
+	vm_flags_set(vma, VM_DONTCOPY | VM_DONTDUMP | VM_DONTEXPAND | VM_IO);
 
 	/*
 	 * For native struct-page-backed GPU allocations, strip VM_IO and
@@ -2566,7 +2566,7 @@
 	 * VM_NOHUGEPAGE prevents THP promotion races during compaction.
 	 */
 	if (reg->cpu_alloc->type == KBASE_MEM_TYPE_NATIVE) {
-		__vm_flags_mod(vma, VM_NOHUGEPAGE, VM_IO | VM_PFNMAP);
+		vm_flags_set(vma, VM_NOHUGEPAGE); vm_flags_clear(vma, VM_IO | VM_PFNMAP);
 	}
 
