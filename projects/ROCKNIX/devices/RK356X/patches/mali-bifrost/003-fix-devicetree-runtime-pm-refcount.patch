From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX
Date: Mon, 11 May 2026 17:00:00 +0800
Subject: [PATCH] midgard: fix devicetree runtime PM refcounting

The Rockchip devicetree platform uses genpd/PM clocks for the GPU power
domain. Avoid querying the shared clock/regulator state to decide whether
to update the Mali driver's own reference counts, since that can skip the
matching enable and later produce unbalanced disables.

Signed-off-by: ROCKNIX
---
 .../platform/devicetree/mali_kbase_runtime_pm.c    | 31 ++++++++-------------
 1 file changed, 14 insertions(+), 17 deletions(-)

diff --git a/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c b/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
index 2687bee..23a8e1d 100644
--- a/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
+++ b/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
@@ -30,47 +30,44 @@
 
 #include "mali_kbase_config_platform.h"
 
+/*
+ * When CONFIG_PM_CLK is active, genpd calls pm_clk_suspend/pm_clk_resume
+ * which also manages device clocks. Checking shared clock/regulator state
+ * before changing Mali's own references can skip the matching enable and
+ * corrupt the refcount, causing "unbalanced disables" or "enabling
+ * unprepared" WARNs.
+ */
 static void enable_gpu_power_control(struct kbase_device *kbdev)
 {
 	unsigned int i;
 
 #if defined(CONFIG_REGULATOR)
 	for (i = 0; i < kbdev->nr_regulators; i++) {
-		if (WARN_ON(kbdev->regulators[i] == NULL))
-			;
-		else if (!regulator_is_enabled(kbdev->regulators[i]))
-			WARN_ON(regulator_enable(kbdev->regulators[i]));
+		if (kbdev->regulators[i])
+			WARN_ON(regulator_enable(kbdev->regulators[i]));
 	}
 #endif
 
 	for (i = 0; i < kbdev->nr_clocks; i++) {
-		if (WARN_ON(kbdev->clocks[i] == NULL))
-			;
-		else if (!__clk_is_enabled(kbdev->clocks[i]))
-			WARN_ON(clk_prepare_enable(kbdev->clocks[i]));
+		if (kbdev->clocks[i])
+			WARN_ON(clk_prepare_enable(kbdev->clocks[i]));
 	}
 }
 
 static void disable_gpu_power_control(struct kbase_device *kbdev)
 {
 	unsigned int i;
 
 	for (i = 0; i < kbdev->nr_clocks; i++) {
-		if (WARN_ON(kbdev->clocks[i] == NULL))
-			;
-		else if (__clk_is_enabled(kbdev->clocks[i])) {
+		if (kbdev->clocks[i])
 			clk_disable_unprepare(kbdev->clocks[i]);
-			WARN_ON(__clk_is_enabled(kbdev->clocks[i]));
-		}
 	}
 
 #if defined(CONFIG_REGULATOR)
 	for (i = 0; i < kbdev->nr_regulators; i++) {
-		if (WARN_ON(kbdev->regulators[i] == NULL))
-			;
-		else if (regulator_is_enabled(kbdev->regulators[i]))
-			WARN_ON(regulator_disable(kbdev->regulators[i]));
+		if (kbdev->regulators[i])
+			WARN_ON(regulator_disable(kbdev->regulators[i]));
 	}
 #endif
 
 }
