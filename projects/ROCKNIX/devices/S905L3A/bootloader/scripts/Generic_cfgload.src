echo "Using device ${device}, number ${devnr}, partition ${partnr}, ROCKNIX on eMMC: ${ce_on_emmc}"

setenv remotewakeupmask "0xffffffff"
setenv vout "1080p60hz"
setenv frac_rate_policy "0"

setenv rootopt "BOOT_IMAGE=kernel.img boot=LABEL=AURKNIX disk=LABEL=STORAGE"
if test "${ce_on_emmc}" = "yes"; then setenv rootopt "BOOT_IMAGE=kernel.img boot=LABEL=AURKNIX disk=LABEL=STORAGE"; fi

if fatload ${device} ${devnr}:${partnr} ${loadaddr} config.ini; then env import -t ${loadaddr} ${filesize}; fi

setenv consoleopt "console=ttyAML0,115200 console=tty0 no_console_suspend"

if test "${cec_func_config}" != ""; then setenv cec "hdmitx=cec${cec_func_config}"; fi
if test "${gpiopower}" != ""; then setenv gpiopower "gpiopower=${gpiopower}"; fi
if test "${max_freq_a53}" != ""; then setenv max_freq_a53 "max_freq_a53=${max_freq_a53}"; fi
if test "${wol}" != ""; then setenv wol "enable_wol=${wol}"; fi
if test "${mac}" != ""; then setenv localmac "mac=${mac}"; fi
if test "${localmac}" = "" && test "${ethaddr}" != ""; then setenv localmac "mac=${ethaddr}"; fi

setenv displayopt "vout=${vout},en frac_rate_policy=${frac_rate_policy} hdmitx=${hdmitx} hdr_policy=1"
setenv initargs "${rootopt} ${consoleopt} ${max_freq_a53} ${wol} ${localmac} ${cec} ${gpiopower} quiet systemd.debug_shell=ttyAML0"
setenv bootargs "${bootargs} ${initargs} ${displayopt}"

fatload ${device} ${devnr}:${partnr} ${loadaddr} kernel.img
fatload ${device} ${devnr}:${partnr} ${dtb_mem_addr} dtb.img

bootm ${loadaddr}
bootm start
bootm loados
bootm prep
bootm go
