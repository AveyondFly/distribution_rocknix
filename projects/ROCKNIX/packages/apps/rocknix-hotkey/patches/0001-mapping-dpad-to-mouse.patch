+void updateFakeMouseMotion()
+{
+  int x = 0;
+  int y = 0;
+  int scale = config.fake_mouse_scale;
+  if (scale == 0) {
+    scale = 1;
+  }
+
+  if (config.left_analog_as_mouse) {
+    x += state.current_left_analog_x / scale;
+    y += state.current_left_analog_y / scale;
+  } else if (config.right_analog_as_mouse) {
+    x += state.current_right_analog_x / scale;
+    y += state.current_right_analog_y / scale;
+  }
+
+  if (config.dpad_as_mouse) {
+    // Match full analog deflection so mouse_scale applies the same way.
+    const int dpad_axis = 32767;
+    if (config.left_as_mouse && state.dpad_left_pressed) {
+      x -= dpad_axis / scale;
+    }
+    if (config.right_as_mouse && state.dpad_right_pressed) {
+      x += dpad_axis / scale;
+    }
+    if (config.up_as_mouse && state.dpad_up_pressed) {
+      y -= dpad_axis / scale;
+    }
+    if (config.down_as_mouse && state.dpad_down_pressed) {
+      y += dpad_axis / scale;
+    }
+  }
+
+  state.mouseX = x;
+  state.mouseY = y;
+}
