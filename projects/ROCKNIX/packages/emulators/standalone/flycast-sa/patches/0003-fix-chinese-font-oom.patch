+#if defined(__linux__)
+// Legacy ImGui GLES backend preloads every glyph in each font source's range at
+// atlas build time. Merged CJK fonts must only declare UI translation glyphs,
+// not full ChineseOfficial/Common ranges (otherwise ~20k glyphs are rasterized).
+static void addPoTranslationGlyphs(ImFontGlyphRangesBuilder& builder, const char* poResource)
+{
+	size_t size;
+	std::unique_ptr<u8[]> data = resource::load(poResource, size);
+	if (data == nullptr)
+		return;
+	const char* text = (const char*)data.get();
+	const char* text_end = text + size;
+	for (const char* p = text; p + 8 <= text_end; p++)
+	{
+		if (strncmp(p, "msgstr \"", 8) != 0)
+			continue;
+		p += 8;
+		std::string msgstr;
+		while (p < text_end && *p != '"')
+		{
+			if (*p == '\\' && p + 1 < text_end)
+			{
+				char c = p[1];
+				if (c == 'n') msgstr += '\n';
+				else if (c == 't') msgstr += '\t';
+				else if (c == '\\') msgstr += '\\';
+				else if (c == '"') msgstr += '"';
+				p += 2;
+				continue;
+			}
+			msgstr += *p++;
+		}
+		builder.AddText(msgstr.c_str());
+	}
+}
+
+static const ImWchar* getChineseUiGlyphRanges(const std::string& locale)
+{
+	static ImVector<ImWchar> ranges;
+	ranges.clear();
+	ImFontGlyphRangesBuilder builder;
+	builder.AddRanges(ImGui::GetIO().Fonts->GetGlyphRangesDefault());
+	const char* po = "i18n/zh_CN.po";
+	if (locale.find("zh_TW") == 0)
+		po = "i18n/zh_TW.po";
+	else if (locale.find("zh_HK") == 0)
+		po = "i18n/zh_HK.po";
+	addPoTranslationGlyphs(builder, po);
+	builder.BuildRanges(&ranges);
+	return ranges.Data;
+}
+#endif
