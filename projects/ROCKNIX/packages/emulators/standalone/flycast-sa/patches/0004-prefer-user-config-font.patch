+static bool tryAddUserConfigFont(float size, ImFontConfig& fontConfig, const ImWchar *glyphRanges)
+{
+	const std::string path = get_writable_config_path("font.ttf");
+	if (path.empty())
+		return false;
+	struct stat st;
+	if (stat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+		return false;
+	return addFont(path.c_str(), size, fontConfig, glyphRanges);
+}
+
+static void addLocaleFonts(const char *path[], float size, ImFontConfig& fontConfig, const ImWchar *glyphRanges)
+{
+	if (tryAddUserConfigFont(size, fontConfig, glyphRanges))
+		return;
+	addFont(path, size, fontConfig, glyphRanges);
+}
