+++ b/core/ui/mainui.cpp	2026-06-21 12:57:29.939218585 +0800
@@ -32,13 +32,24 @@
 #include <thread>
 
 static bool mainui_enabled;
+volatile sig_atomic_t flycast_request_shutdown = 0;
 u32 MainFrameCount;
 static bool forceReinit;
 
+static inline void mainui_poll_shutdown()
+{
+	if (flycast_request_shutdown)
+		mainui_enabled = false;
+}
+
 bool mainui_rend_frame()
 {
 	FC_PROFILE_SCOPE;
 
+	mainui_poll_shutdown();
+	if (!mainui_enabled)
+		return false;
+
 	os_DoEvents();
 	os_UpdateInputState();
 
@@ -103,6 +114,10 @@
 
 	while (mainui_enabled)
 	{
+		mainui_poll_shutdown();
+		if (!mainui_enabled)
+			break;
+
 		fc_profiler::startThread("main");
 
 		if (mainui_rend_frame() && imguiDriver != nullptr)
@@ -160,6 +175,8 @@
 void mainui_stop()
 {
 	mainui_enabled = false;
+	flycast_request_shutdown = 0;
+	rend_cancel_emu_wait();
 }
 
 void mainui_reinit()
