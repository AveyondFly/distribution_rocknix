+
+static void skipScifSerialPort(Deserializer& deser)
+{
+	if (deser.version() < Deserializer::V43)
+		return;
+
+	skipSchedulerEntry(deser);	// serial byte scheduler
+	skipSchedulerEntry(deser);	// break scheduler
+	deser.skip<int>();			// statusLastRead
+	int size;
+	deser >> size;
+	deser.skip(size);			// txFifo
+	deser >> size;
+	deser.skip(size);			// rxFifo
+	deser.skip<bool>();			// transmitting
+}
