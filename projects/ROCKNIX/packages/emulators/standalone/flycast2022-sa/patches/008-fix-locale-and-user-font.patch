@@ -220,13 +220,31 @@
     {"Full", {"Full", "完整"}},
 };
 
+#if defined(__linux__)
+inline const char* getLinuxUiLocale()
+{
+	const char* locale = setlocale(LC_MESSAGES, nullptr);
+	if (locale == nullptr || locale[0] == '\0' || strcmp(locale, "C") == 0 || strcmp(locale, "POSIX") == 0)
+		locale = getenv("LANG");
+	if (locale == nullptr || locale[0] == '\0' || strcmp(locale, "C") == 0 || strcmp(locale, "POSIX") == 0)
+		locale = getenv("LANGUAGE");
+	if (locale == nullptr || locale[0] == '\0')
+		locale = setlocale(LC_ALL, nullptr);
+	return locale;
+}
+#endif
+
 inline bool isChineseLocale() {
     static int cached = -1;
     if (cached == -1) {
+#if defined(__linux__)
+        const char* locale = getLinuxUiLocale();
+#else
         setlocale(LC_ALL, "");
         const char* locale = setlocale(LC_ALL, nullptr);
         if (locale == nullptr || strcmp(locale, "C") == 0 || strcmp(locale, "POSIX") == 0)
             locale = getenv("LANG");
+#endif
         cached = (locale != nullptr && strstr(locale, "zh") != nullptr) ? 1 : 0;
     }
     return cached == 1;
