 int main(int argc, char* argv[])
 {
+	// Java reads the original stderr pipe as binary events. Save that pipe,
+	// then route library stderr to the inherited diagnostic stdout instead.
+	int event_fd = dup(STDERR_FILENO);
+	if (event_fd < 0) {
+		perror("Unable to duplicate control pipe");
+		return 1;
+	}
+	event_output = fdopen(event_fd, "wb");
+	if (!event_output) {
+		close(event_fd);
+		perror("Unable to open control pipe");
+		return 1;
+	}
+	setvbuf(event_output, NULL, _IONBF, 0);
+	if (dup2(STDOUT_FILENO, STDERR_FILENO) < 0) {
+		perror("Unable to redirect SDL diagnostics");
+		fclose(event_output);
+		return 1;
+	}
+
