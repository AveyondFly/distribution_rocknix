# MRP phone keypad mapping for mrpoid-sdl2
# DPad and analog keep the classic 2/4/6/8 phone-game direction layout.
back = f1
start = f2
guide = f4
a = 5
a_hk = f4
b = 0
b_hk = f3
x = s
x_hk = m
y = d
y_hk = \\
l1 = 1
l1_hk = pageup
l2 = 7
l2_hk = enter
l3 = f4
r1 = 3
r1_hk = pagedown
r2 = 9
r2_hk = backspace
r3 = f3
up = 2
down = 8
left = 4
right = 6
up_hk = up
down_hk = down
left_hk = left
right_hk = right
left_analog_up = 2
left_analog_down = 8
left_analog_left = 4
left_analog_right = 6
right_analog_up = 2
right_analog_down = 8
right_analog_left = 4
right_analog_right = 6
deadzone_triggers = 3000
mouse_scale = 6128
mouse_delay = 16
