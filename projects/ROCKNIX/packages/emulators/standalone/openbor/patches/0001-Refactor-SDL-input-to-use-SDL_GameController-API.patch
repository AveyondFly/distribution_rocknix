-	else                                      return JoystickUnknownNames[keycode-firstUnknown];
+	int firstAxis = SDL_CONTROLLER_BUTTON_MAX;
+	static char name[64];
+	
+	if (keynum < firstAxis+1) {
+        if (keynum == 0) return "...";
+        int btn = keynum - 1;
+        const char* btn_name = SDL_GameControllerGetStringForButton((SDL_GameControllerButton)btn);
+        if(btn_name) sprintf(name, "P%d %s", portnum+1, btn_name);
+        else sprintf(name, "P%d Button %d", portnum+1, btn);
+        return name;
+	} else {
+        int axis_idx = (keynum - 1 - firstAxis) / 2;
+        int axis_dir = (keynum - 1 - firstAxis) % 2;
+        const char* axis_name = SDL_GameControllerGetStringForAxis((SDL_GameControllerAxis)axis_idx);
+        if(axis_name) sprintf(name, "P%d %s %s", portnum+1, axis_name, axis_dir == 0 ? "-" : "+");
+        else sprintf(name, "P%d Axis %d %s", portnum+1, axis_idx, axis_dir == 0 ? "-" : "+");
+        return name;
+    }
 }
 
 char* JOY_GetKeyName(int keycode)
 {
+#ifdef OPENDINGUX
+	return OPENDINGUX_GetKeyName(keycode);
+#else
+	if (keycode >= JOY_LIST_FIRST && keycode <= JOY_LIST_LAST) {
+		int portnum = (keycode - JOY_LIST_FIRST - 1) / JOY_MAX_INPUTS;
+		int keynum = (keycode - JOY_LIST_FIRST - 1) % JOY_MAX_INPUTS + 1;
+		if (portnum >= 0 && portnum < JOY_LIST_TOTAL) {
+			return (char*)PC_GetJoystickKeyName(portnum, keynum);
+		}
+	}
+#if ANDROID || DARWIN || SDL2
 	return (char*)SDL_GetScancodeName(keycode);
+#else
+	return (char*)SDL_GetKeyName(keycode);
+#endif
+#endif
 }
