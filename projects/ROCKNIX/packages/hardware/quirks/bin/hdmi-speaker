if [ -z "${QUIRK_DEVICE}" ]; then
  QUIRK_DEVICE="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"
fi

if [ -x "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/hdmi-speaker" ]; then
  exec "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/hdmi-speaker"
fi
