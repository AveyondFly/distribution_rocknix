# AISLPC RG52 Mini power LED — dual GPIO (GPIO3_A0/A1 = gpio96/97):
#   96 97 | color
#   0  0  | off
#   0  1  | red
#   1  0  | green
#   1  1  | blue

if [ "$1" = "list" ]; then
  cat <<EOF
default
off
green
red
blue
amber
EOF
  exit 0
fi

. /etc/profile.d/001-functions

LED_GREEN=/sys/class/leds/power:green/brightness
LED_RED=/sys/class/leds/power:red/brightness
DEFAULT=green
LED_STATUS=$(get_setting led.color)

set_led_pair() {
  echo "$1" > "${LED_GREEN}"
  echo "$2" > "${LED_RED}"
}

apply_color() {
  case ${1} in
    off)
      set_led_pair 0 0
      ;;
    red)
      set_led_pair 0 1
      ;;
    green|default)
      set_led_pair 1 0
      ;;
    blue|amber)
      set_led_pair 1 1
      ;;
    *)
      set_led_pair 1 0
      ;;
  esac
}

case ${1} in
  default)
    del_setting led.color
    apply_color ${DEFAULT}
    ;;
  green|red|blue|amber|off)
    apply_color ${1}
    set_setting led.color ${1}
    ;;
  discharging)
    apply_color ${LED_STATUS:-${DEFAULT}}
    ;;
  charging)
    if [ "${LED_STATUS}" != "off" ]; then
      apply_color red
    fi
    ;;
  poweroff)
    apply_color off
    ;;
  brightness|"")
    apply_color ${LED_STATUS:-${DEFAULT}}
    ;;
esac
