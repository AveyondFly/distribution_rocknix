cat <<EOF >/storage/.config/profile.d/002-audio_path
DEVICE_PLAYBACK_PATH_SPK="SPK"
DEVICE_PLAYBACK_PATH_HP="HP"
DEVICE_PLAYBACK_PATH="Playback Path"
EOF

### Set sound properties for RK817 codec
amixer -c 0 -q cset name='Playback Path' 2

### Restart pipewire to ensure sink is picked up correctly
systemctl restart pipewire
