# Power/charging LEDs use GPIO3_A0/A1; stick LEDs use a separate UART MCU.
cat <<'EOF' >/storage/.config/profile.d/011-led_control
DEVICE_LED_CONTROL="true"
DEVICE_LED_CHARGING="true"
DEVICE_LED_BRIGHTNESS="false"
DEVICE_ANALOG_STICKS_LED_SINGLE="true"
DEVICE_ANALOG_STICKS_LED_CONTROL="false"
EOF
