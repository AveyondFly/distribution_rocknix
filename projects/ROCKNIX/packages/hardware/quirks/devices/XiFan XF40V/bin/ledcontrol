#!/bin/bash

if [ "$1" = "list" ]; then
cat <<EOF
off
red
blue
purple
EOF
  exit 0
fi

. /etc/profile

# 获取脚本的第一个参数，即颜色名称
COLOR=${1:-$(get_setting led.color)}
case ${COLOR} in
  poweroff)
    # Temporary shutdown/suspend state; do not overwrite the saved color.
    COLOR=off
    ;;
  *_off)
    COLOR=off
    set_setting led.color "${COLOR}"
    ;;
  *_on)
    COLOR=${COLOR%_on}
    [ "${COLOR}" = "all" ] && COLOR=purple
    set_setting led.color "${COLOR}"
    ;;
esac


# 根据颜色名称设置 LED 状态
case $COLOR in
    purple)
    echo 1 > /sys/class/leds/power:blue/brightness
    echo 1 > /sys/class/leds/power:red/brightness
        ;;
    blue)
    echo 1 > /sys/class/leds/power:blue/brightness
    echo 0 > /sys/class/leds/power:red/brightness
        ;;
    red)
    echo 0 > /sys/class/leds/power:blue/brightness
    echo 1 > /sys/class/leds/power:red/brightness
        ;;
    off)
    echo 0 > /sys/class/leds/power:blue/brightness
    echo 0 > /sys/class/leds/power:red/brightness
        ;;
esac
