# The charge indicator is handled by the hardware.  Prevent the RK356X
# powerstate hooks from overriding the user-selected red/blue status LED.
cat <<EOF >/storage/.config/profile.d/011-led_control
DEVICE_LED_CHARGING="false"
EOF
