. /etc/profile

LED_STATE=$(get_setting "led.color")
if [ -z "${LED_STATE}" ]; then
	LED_STATE="blue_on"
	set_setting "led.color" "blue_on"
fi
/usr/bin/ledcontrol "${LED_STATE}"

ANALOG_STICK_LED_STATE=$(get_setting "analogsticks.led.color")
if [ -z "${ANALOG_STICK_LED_STATE}" ]; then
	ANALOG_STICK_LED_STATE="off"
	set_setting "analogsticks.led.color" "off"
fi

/usr/bin/analog_sticks_ledcontrol_single "${ANALOG_STICK_LED_STATE}"
