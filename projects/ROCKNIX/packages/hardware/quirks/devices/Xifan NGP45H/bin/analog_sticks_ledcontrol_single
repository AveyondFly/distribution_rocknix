if [ "$1" = "list" ]; then
	cat <<EOF
OFF
Scrolling
Breathing
Breathing_Red
Breathing_Green
Breathing_Blue
Breathing_Blue_Red
Breathing_Green_Blue
Breathing_Red_Green
Breathing_Red_Green_Blue
Red_Green_Blue
Blue_Red
Blue
Green_Blue
Green
Red_Green
Red
EOF
else
	if LED_PIDS=$(pidof ws2812-common); then
		kill -9 ${LED_PIDS}
	fi
	/usr/bin/ws2812-common --device /dev/spidev0.0 "$1" &
fi
