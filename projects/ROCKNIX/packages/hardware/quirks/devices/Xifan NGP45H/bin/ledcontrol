#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ROCKNIX (https://github.com/ROCKNIX)

# NGP45H two-channel status LED:
#   GPIO3_C1 (gpio113) = blue
#   GPIO3_C2 (gpio114) = red
#
# Charging indication is hardware-controlled and intentionally not handled
# here.  This command only applies the color selected by the user.

if [ "$1" = "list" ]; then
	cat <<EOF
off
red
blue
purple
EOF
	exit 0
fi

. /etc/profile.d/001-functions

GPIO_BLUE=113
GPIO_RED=114

gpio_export() {
	for gpio in ${GPIO_BLUE} ${GPIO_RED}; do
		if [ ! -d "/sys/class/gpio/gpio${gpio}" ]; then
			echo "${gpio}" > /sys/class/gpio/export 2>/dev/null
		fi
		echo out > "/sys/class/gpio/gpio${gpio}/direction" 2>/dev/null
	done
}

set_gpio_pair() {
	echo "$1" > "/sys/class/gpio/gpio${GPIO_BLUE}/value"
	echo "$2" > "/sys/class/gpio/gpio${GPIO_RED}/value"
}

apply_color() {
	case "$1" in
		off)
			set_gpio_pair 0 0
			;;
		blue)
			set_gpio_pair 1 0
			;;
		red)
			set_gpio_pair 0 1
			;;
		purple)
			set_gpio_pair 1 1
			;;
		*)
			set_gpio_pair 1 0
			;;
	esac
}

gpio_export

case "$1" in
	default)
		del_setting led.color
		apply_color blue
		;;
	off|red|blue|purple)
		apply_color "$1"
		set_setting led.color "$1"
		;;
	discharging|brightness|"")
		apply_color "$(get_setting led.color)"
		;;
	poweroff)
		apply_color off
		;;
esac
