# NGP45H two-channel status LED:
#   GPIO3_C1 (gpio113) = blue
#   GPIO3_C2 (gpio114) = red
#
# Charging indication is hardware-controlled and intentionally not handled
# here.  This command only applies the color selected by the user.

if [ "$1" = "list" ]; then
	cat <<EOF
off
red
blue
purple
EOF
	exit 0
fi

. /etc/profile.d/001-functions

LED_BLUE=/sys/class/leds/power:blue/brightness
LED_RED=/sys/class/leds/power:red/brightness

set_led_pair() {
	echo "$1" > "${LED_BLUE}"
	echo "$2" > "${LED_RED}"
}

apply_color() {
	case "$1" in
		off)
			set_led_pair 0 0
			;;
		blue)
			set_led_pair 1 0
			;;
		red)
			set_led_pair 0 1
			;;
		purple)
			set_led_pair 1 1
			;;
		*)
			set_led_pair 1 0
			;;
	esac
}

case "$1" in
	default)
		del_setting led.color
		apply_color blue
		;;
	off|red|blue|purple)
		apply_color "$1"
		set_setting led.color "$1"
		;;
	discharging|brightness|"")
		apply_color "$(get_setting led.color)"
		;;
	poweroff)
		apply_color off
		;;
esac
