# HDMI audio routing before pipewire starts.
# CoreELEC on SC2/S905X4: Kodi uses ALSA DEV=0 (SPDIF-B) with
# HDMITX Audio Source Select = Spdif_b. Do not route via Tdm_C.

mixer() {
  amixer -c "$1" sset "$2" "$3" >/dev/null 2>&1
}

card=0

# This script is installed only for DEVICE=S905L3A, and the matching
# WirePlumber profile routes playback to SPDIF-B (hw:0,0).
mixer "${card}" 'HDMITX Audio Source Select' 'Spdif_b'
mixer "${card}" 'Audio I2S to HDMITX Format' 'Stereo PCM'
mixer "${card}" 'Audio hdmi-out mute' off

exit 0
