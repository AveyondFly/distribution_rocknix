[Unit]
Description=RGB20SX mono speaker downmix
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/lib/autostart/quirks/bin/rgb20sx-mono-audio
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
