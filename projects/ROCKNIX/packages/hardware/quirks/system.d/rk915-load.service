[Unit]
Description=Initialize device Wi-Fi before wireless network managers
After=systemd-modules-load.service local-fs.target
Before=iwd.service connman.service
ConditionPathExists=/proc/device-tree/wireless-wlan/wifi_chip_type

[Service]
Type=oneshot
ExecStart=/usr/lib/autostart/quirks/bin/wifi-driver-load
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
