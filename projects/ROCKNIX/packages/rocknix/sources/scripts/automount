#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

. /etc/profile
. /etc/os-release

MOUNT_GAMES=$(get_setting system.automount)
SELECTED_STORAGE=$(get_setting system.games.storage)
ROMS_PATH="/storage/roms"
INTERNAL_PATH="/storage/games-internal"
EXTERNAL_PATH="/storage/games-external"
ACTIVE_STORAGE_FILE="/run/rocknix-games-storage"
GAME_DIRS_MARKER=".rocknix-system-dirs-created"
PREVIOUS_STORAGE=$(cat "${ACTIVE_STORAGE_FILE}" 2>/dev/null)
HOTPLUG_EVENT=0

if [ -e "/run/rocknix-games-hotplug" ]
then
  HOTPLUG_EVENT=1
  rm -f /run/rocknix-games-hotplug
fi

log_message() {
  log "$0" "$1"
}

is_mounted() {
  /usr/bin/busybox mountpoint -q "$1"
}

unmount_path() {
  if is_mounted "$1"
  then
    log_message "Unmount $1."
    /usr/bin/busybox umount -f "$1" 2>/dev/null ||:
  fi
}

parent_disk() {
  local DEVICE_NAME
  DEVICE_NAME=${1##*/}

  case "${DEVICE_NAME}" in
    mmcblk*p[0-9]*|nvme*p[0-9]*) echo "${DEVICE_NAME%p*}" ;;
    sd*[0-9]*) echo "${DEVICE_NAME%%[0-9]*}" ;;
    *) echo "${DEVICE_NAME}" ;;
  esac
}

load_modules() {
  local MODULE
  for MODULE in exfat vfat ntfs ntfs3
  do
    if ! lsmod | grep -q "^${MODULE}"
    then
      log_message "Loading ${MODULE}."
      modprobe "${MODULE}" >/dev/null 2>&1 ||:
    fi
  done
}

mount_device() {
  local DEVICE=$1
  local STORAGE=$2
  local MOUNT_PATH FSTYPE MPV_PID

  case "${STORAGE}" in
    internal) MOUNT_PATH="${INTERNAL_PATH}" ;;
    external) MOUNT_PATH="${EXTERNAL_PATH}" ;;
    *) return 1 ;;
  esac

  if is_mounted "${MOUNT_PATH}"
  then
    return 0
  fi

  FSTYPE=$(blkid -o export "${DEVICE}" | awk -F= '$1 == "TYPE" {print $2; exit}')
  mkdir -p "${MOUNT_PATH}"
  log_message "Mounting ${DEVICE} on ${MOUNT_PATH}."

  case "${FSTYPE}" in
    ntfs)
      /usr/bin/busybox mount -t ntfs3 -o rw,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
      ;;
    vfat)
      /usr/bin/busybox mount -o rw,utf8,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
      ;;
    *)
      /usr/bin/busybox mount -o rw,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
      ;;
  esac

  if ! is_mounted "${MOUNT_PATH}"
  then
    log_message "Failed to mount ${DEVICE} on ${MOUNT_PATH}."
    return 1
  fi

  log_message "Checking filesystem ${DEVICE}."
  if ! touch "${MOUNT_PATH}/.tmp-rocknix"
  then
    log_message "Fixing filesystem ${DEVICE}."
    /usr/bin/fsck_prompt &
    MPV_PID=$!
    /usr/bin/busybox umount "${MOUNT_PATH}" >/dev/null 2>&1 ||:
    /usr/sbin/fsck -Mly "${DEVICE}" >/dev/null 2>&1 ||:

    case "${FSTYPE}" in
      ntfs)
        /usr/bin/busybox mount -t ntfs3 -o rw,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
        ;;
      vfat)
        /usr/bin/busybox mount -o rw,utf8,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
        ;;
      *)
        /usr/bin/busybox mount -o rw,noatime "${DEVICE}" "${MOUNT_PATH}" >/dev/null 2>&1
        ;;
    esac

    kill "${MPV_PID}" 2>/dev/null ||:
    wait "${MPV_PID}" 2>/dev/null ||:
  else
    rm -f "${MOUNT_PATH}/.tmp-rocknix"
  fi

  is_mounted "${MOUNT_PATH}"
}

create_game_dirs() {
  local SOURCE_PATH=$1

  [ -n "${SOURCE_PATH}" ] || return 0
  local MARKER_PATH="${SOURCE_PATH}/${GAME_DIRS_MARKER}"

  if [ -e "${MARKER_PATH}" ]
  then
    log_message "Game directories already initialized on ${SOURCE_PATH}."
    return 0
  fi

  if is_mounted "${ROMS_PATH}" && [ -e "/usr/config/system-dirs.conf" ]
  then
    log_message "Creating game directories on ${SOURCE_PATH}."
    if systemd-tmpfiles --create /usr/config/system-dirs.conf >/dev/null 2>&1
    then
      if ! touch "${MARKER_PATH}"
      then
        log_message "Failed to create game directory marker ${MARKER_PATH}."
        return 1
      fi
    else
      log_message "Failed to create game directories on ${SOURCE_PATH}."
      return 1
    fi
  fi
}

record_active_storage() {
  local ACTIVE_STORAGE=$1

  mkdir -p "${ACTIVE_STORAGE_FILE%/*}"
  printf '%s\n' "${ACTIVE_STORAGE}" > "${ACTIVE_STORAGE_FILE}"
}

activate_selected_storage() {
  local ACTIVE_STORAGE SOURCE_PATH TARGET_STORAGE

  TARGET_STORAGE=${SELECTED_STORAGE:-auto}
  # A hotplug event may add a newly available preferred card. Keep the current
  # card active until the user explicitly switches it in EmulationStation.
  # If the active card was removed, the normal fallback below still applies.
  if [ "${HOTPLUG_EVENT}" = "1" ] && \
     [[ "${PREVIOUS_STORAGE}" =~ ^(internal|external)$ ]]
  then
    TARGET_STORAGE=${PREVIOUS_STORAGE}
  fi

  case "${TARGET_STORAGE}" in
    internal)
      if is_mounted "${INTERNAL_PATH}"
      then
        ACTIVE_STORAGE="internal"
        SOURCE_PATH="${INTERNAL_PATH}"
      elif is_mounted "${EXTERNAL_PATH}"
      then
        ACTIVE_STORAGE="external"
        SOURCE_PATH="${EXTERNAL_PATH}"
      fi
      ;;
    external)
      if is_mounted "${EXTERNAL_PATH}"
      then
        ACTIVE_STORAGE="external"
        SOURCE_PATH="${EXTERNAL_PATH}"
      elif is_mounted "${INTERNAL_PATH}"
      then
        ACTIVE_STORAGE="internal"
        SOURCE_PATH="${INTERNAL_PATH}"
      fi
      ;;
    auto|*)
      # Auto preserves the historical external-first behavior. Missing or
      # invalid settings are also treated as auto without rewriting config.
      if is_mounted "${EXTERNAL_PATH}"
      then
        ACTIVE_STORAGE="external"
        SOURCE_PATH="${EXTERNAL_PATH}"
      elif is_mounted "${INTERNAL_PATH}"
      then
        ACTIVE_STORAGE="internal"
        SOURCE_PATH="${INTERNAL_PATH}"
      fi
      ;;
  esac

  if [ -n "${SOURCE_PATH}" ]
  then
    log_message "Using ${ACTIVE_STORAGE} game storage at ${ROMS_PATH}."
    /usr/bin/busybox mount --bind "${SOURCE_PATH}" "${ROMS_PATH}"
  else
    log_message "No game partition is available; leaving ${ROMS_PATH} unmounted."
  fi

  record_active_storage "${ACTIVE_STORAGE}"
  create_game_dirs "${SOURCE_PATH}"
}

eject_external_storage() {
  local ACTIVE_STORAGE

  if [ "${PREVIOUS_STORAGE}" = "external" ]
  then
    unmount_path "${ROMS_PATH}"
  fi
  unmount_path "${EXTERNAL_PATH}"

  if [ "${PREVIOUS_STORAGE}" = "external" ] && is_mounted "${INTERNAL_PATH}"
  then
    /usr/bin/busybox mount --bind "${INTERNAL_PATH}" "${ROMS_PATH}"
    ACTIVE_STORAGE="internal"
  elif [ "${PREVIOUS_STORAGE}" != "external" ]
  then
    ACTIVE_STORAGE="${PREVIOUS_STORAGE}"
  fi

  record_active_storage "${ACTIVE_STORAGE}"
}

find_and_mount_games() {
  local FLASH_DEVICE SYSTEM_DISK DEVICE ROOT_DEVICE SIZE STORAGE

  FLASH_DEVICE=$(awk '$2 == "/flash" {print $1; exit}' /proc/mounts)
  SYSTEM_DISK=$(parent_disk "${FLASH_DEVICE}")
  log_message "System disk detected: ${SYSTEM_DISK:-unknown}."

  for DEVICE in $(blkid | awk -F: '/TYPE="(ext4|btrfs|exfat|vfat|fat|ntfs)"/ {print $1}' | sort -r)
  do
    ROOT_DEVICE=$(parent_disk "${DEVICE}")
    [ -n "${ROOT_DEVICE}" ] || continue

    if [ "${ROOT_DEVICE}" = "${SYSTEM_DISK}" ]
    then
      STORAGE="internal"
    else
      STORAGE="external"
    fi

    if is_mounted "/storage/games-${STORAGE}"
    then
      continue
    fi

    SIZE=$(awk -v dev="${ROOT_DEVICE}" '$4 == dev {print $3; exit}' /proc/partitions)
    if [ -z "${SIZE}" ] && [ -r "/sys/class/block/${ROOT_DEVICE}/size" ]
    then
      SIZE=$(($(cat "/sys/class/block/${ROOT_DEVICE}/size") / 2))
    fi
    if [ -z "${SIZE}" ] || (( SIZE <= 8388608 ))
    then
      log_message "Device ${ROOT_DEVICE} is too small, ignoring ${DEVICE}."
      continue
    fi
    if [ -L "/sys/class/block/${ROOT_DEVICE}boot0" ]
    then
      log_message "Device ${ROOT_DEVICE} might be Android storage, ignoring ${DEVICE}."
      continue
    fi
    if grep -q "^${DEVICE} " /proc/mounts
    then
      continue
    fi
    if [ -e "${DEVICE}" ] && [ ! -e "/storage/.please_resize_me" ]
    then
      log_message "Found ${STORAGE} game partition ${DEVICE}."
      mount_device "${DEVICE}" "${STORAGE}" ||:
    fi
  done
}

case "$1" in
  eject-external)
    eject_external_storage
    exit 0
    ;;
esac

load_modules

# Always remove the compatibility bind first, followed by both source paths.
unmount_path "${ROMS_PATH}"
unmount_path "${INTERNAL_PATH}"
unmount_path "${EXTERNAL_PATH}"

rm -f /storage/.ms_supported /storage/.ms_unsupported

if [[ ! "${MOUNT_GAMES}" =~ ^[0-9]+$ ]]
then
  set_setting system.automount 1
  MOUNT_GAMES=1
fi

if [ "${MOUNT_GAMES}" = "0" ]
then
  record_active_storage ""
  exit 0
fi

find_and_mount_games
activate_selected_storage
