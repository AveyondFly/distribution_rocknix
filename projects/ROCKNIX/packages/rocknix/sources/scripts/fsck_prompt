#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Display a fsck progress prompt only when automount needs to repair storage.

FSCK_IMG="/tmp/fsck_prompt.png"
MPV_PID=""

get_display_rotation() {
  local fbcon_rotate

  if [ -r /sys/class/graphics/fbcon/rotate ]; then
    read -r fbcon_rotate </sys/class/graphics/fbcon/rotate
    case "$fbcon_rotate" in
      1) echo 90; return ;;
      2) echo 180; return ;;
      3) echo 270; return ;;
    esac
  fi

  echo 0
}

cleanup() {
  if [ -n "$MPV_PID" ]; then
    kill "$MPV_PID" 2>/dev/null
    wait "$MPV_PID" 2>/dev/null
  fi
  rm -f "$FSCK_IMG"
}

trap cleanup EXIT INT TERM

echo "" | base64 -d > "$FSCK_IMG"
MPV_ROTATION="$(get_display_rotation)"

env -u WAYLAND_DISPLAY -u DISPLAY -u SDL_VIDEODRIVER \
  XDG_RUNTIME_DIR=/var/run/0-runtime-dir \
  mpv --no-config --osc=no --vo=drm --fullscreen --no-terminal --loop-file=inf \
    --video-rotate="$MPV_ROTATION" "$FSCK_IMG" >/dev/null 2>&1 &
MPV_PID=$!

while kill -0 "$MPV_PID" 2>/dev/null; do
  sleep 1
done
