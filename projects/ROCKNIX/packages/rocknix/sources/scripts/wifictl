#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2022 kkoshelev (https://github.com/kkoshelev)
# Refactored for iwd (including AP mode)
# Symlink management added for read-only root filesystems.

. /etc/profile

###
### Basic WIFI properties used across the tool.
###
### Usage:
###     wifictl command [ssid] [psk]
###

IWD_AP_CFG_DIR="/storage/.cache/iwd/ap"
CONNMAN_CFG_DIR="/storage/.cache/connman"
WIFI_TYPE=$(get_setting wifi.adhoc.enabled)
NETWORK_ADDRESS="192.168.80"
ADHOC_CLIENT_ID=$(get_setting wifi.adhoc.id)
WIFI_DEV="$(ls /sys/class/net | grep -m1 ^wlan)"
DEFAULT_CHAN="6"
USE_CONNMAN_WIFI="no"

if connmanctl technologies 2>/dev/null | grep -q '/technology/wifi'; then
  USE_CONNMAN_WIFI="yes"
fi

# Exit the script if the WiFi device isn't available
[ -z "${WIFI_DEV}" ] && exit 0
[ ! -d "/sys/class/net/${WIFI_DEV}" ] && exit 0

SSID="${2:-$(get_setting wifi.ssid 2>/dev/null)}"
PSK="${3:-$(get_setting wifi.key 2>/dev/null)}"
COUNTRY="${4:-$(get_setting wifi.country | tr -d '[:space:]' 2>/dev/null)}"

if [ "${WIFI_TYPE}" = "1" ]; then
  SSID="NETPLAY_AP"
  PSK="deadbeef"
fi

ADHOC_CHAN=$(get_setting wifi.adhoc.channel)
if [ -z "${ADHOC_CHAN}" ]; then
  ADHOC_CHAN="${DEFAULT_CHAN}"
  set_setting wifi.adhoc.channel ${DEFAULT_CHAN}
fi

###
### Functions...
###

connman_wifi_service() {
  connmanctl services 2>/dev/null | awk -v ssid="${SSID}" '
    $0 ~ ssid && /wifi_/ {
      print $NF
      exit
    }'
}

connman_write_service_config() {
  local service="${1}"

  mkdir -p "${CONNMAN_CFG_DIR}"
  cat >"${CONNMAN_CFG_DIR}/${service}.config" <<EOF
[service_${service}]
Type=wifi
Name=${SSID}
Passphrase=${PSK}
EOF
}

connman_scan_wifi() {
  timeout 10 connmanctl scan wifi >/dev/null 2>&1
}

connman_restart() {
  systemctl restart connman.service >/dev/null 2>&1
  sleep 3
  connmanctl enable wifi >/dev/null 2>&1
}

connman_list_wifi_services() {
  connmanctl services 2>/dev/null | awk '/wifi_/ {
    n=NF
    if ($n !~ /^wifi_/) next
    if (n >= 2 && $1 !~ /^wifi_/ && $1 !~ /^\*?[ARO]+$/) {
      print $1
    } else if (n >= 3 && $2 !~ /^wifi_/) {
      print $2
    }
  }' | sort -u
}

wait_for_wifi() {
  for i in $(seq 1 10); do
    [ -d "/sys/class/net/${WIFI_DEV}" ] && break
    sleep 1
  done
  [ -n "${COUNTRY}" ] && iw reg set "${COUNTRY}"

  if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
    connmanctl enable wifi >/dev/null 2>&1
    return
  fi

  for i in $(seq 1 5); do
    iwctl device list 2>/dev/null | grep -q "${WIFI_DEV}" && break
    sleep 1
  done
}

# lists all wifi networks
list_wifi() {
  wait_for_wifi

  if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
    connman_scan_wifi || true
    sleep 2
    connman_list_wifi_services
    return
  fi

  /usr/bin/iwd_get-networks
}

connect_wifi() {
  wait_for_wifi

  if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
    SERVICE="$(connman_wifi_service)"
    if [ -z "${SERVICE}" ]; then
      connman_scan_wifi || true
      sleep 3
      SERVICE="$(connman_wifi_service)"
    fi
    if [ -z "${SERVICE}" ]; then
      connman_restart
      connman_scan_wifi || true
      sleep 3
      SERVICE="$(connman_wifi_service)"
    fi
    [ -z "${SERVICE}" ] && return 1
    connman_write_service_config "${SERVICE}"
    timeout 30 connmanctl connect "${SERVICE}" >/dev/null 2>&1
    return
  fi

  iwctl device ${WIFI_DEV} set-property Mode station
  iwctl --passphrase "${PSK}" station ${WIFI_DEV} connect "${SSID}" 2>/dev/null
}

create_adhoc() {
  wait_for_wifi

  # Create an iwd AP profile file
  cat <<EOF >"${IWD_AP_CFG_DIR}/${SSID}.ap"
[General]
Channel=${ADHOC_CHAN}
DisableHT=true

[Security]
Passphrase=${PSK}

[IPv4]
Address=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
Netmask=255.255.255.0
Gateway=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
EOF

  iwctl device ${WIFI_DEV} set-property Mode ap
  iwctl ap ${WIFI_DEV} start-profile "${SSID}" 2>/dev/null
}

destroy_adhoc() {
  iwctl ap ${WIFI_DEV} stop 2>/dev/null
  rm -f "${IWD_AP_CFG_DIR}/${SSID}.ap" 2>/dev/null
}

has_ap_mode() {
  wait_for_wifi

  if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
    PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
    if iw phy "${PHY}" info 2>/dev/null | grep -q '\* AP'; then
      exit 0
    fi
    exit 1
  fi

  PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
  if iwctl adapter "$PHY" show | grep -q 'SupportedModes.*ap'; then
    exit 0
  else
    exit 1
  fi
}

case "${1}" in
  enable)
    rfkill unblock wifi
    if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
      connmanctl enable wifi >/dev/null 2>&1
    fi
    ;;
  disable)
    if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
      connmanctl disable wifi >/dev/null 2>&1
    fi
    rfkill block wifi
    ;;
  connect)
    if [ "${WIFI_TYPE}" = "1" ] && \
       [ "${ADHOC_CLIENT_ID}" = "1" ]; then
      create_adhoc >/dev/null 2>&1
    else
      destroy_adhoc >/dev/null 2>&1
      connect_wifi >/dev/null 2>&1
    fi
  ;;
  disconnect)
    if [ "${WIFI_TYPE}" = "1" ]; then
      destroy_adhoc >/dev/null 2>&1
      iwctl ap ${WIFI_DEV} stop 2>/dev/null
    elif [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
      connmanctl disconnect >/dev/null 2>&1
    else
      iwctl station ${WIFI_DEV} disconnect 2>/dev/null
    fi
    ;;
  reconnect)
    /usr/bin/wifictl disconnect
    /usr/bin/wifictl connect
    ;;
  list)
    list_wifi
    ;;
  channels)
    iw list | awk '/[0-9] MHz \[/ && ! /disabled|radar|no IR/ { gsub(/^.*\[/,""); gsub(/\].*$/,""); print}'
    ;;
  has_ap_mode)
    has_ap_mode
    ;;
  scan)
    if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
      connman_scan_wifi
    else
      iwctl station ${WIFI_DEV} scan 2>/dev/null
    fi
    ;;
  scanlist)
    if [ "${USE_CONNMAN_WIFI}" = "yes" ]; then
      connman_scan_wifi || true
      sleep 2
      connman_list_wifi_services
    else
      iwctl station ${WIFI_DEV} scan 2>/dev/null
      sleep 2
      list_wifi
    fi
    ;;
esac
