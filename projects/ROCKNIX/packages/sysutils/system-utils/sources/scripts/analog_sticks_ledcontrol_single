#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)

###
### Single-stick / unified preset LED CLI: `list`, then `<preset>` (and any other args the device needs).
### Quirks ship .../bin/analog_sticks_ledcontrol_single (DEVICE_ANALOG_STICKS_LED_SINGLE).
###

if [ -z "${QUIRK_DEVICE}" ] || [ -z "${HW_DEVICE}" ]; then
  . /etc/profile
fi

if [ -f "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/analog_sticks_ledcontrol_single" ]; then
  exec "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/analog_sticks_ledcontrol_single" $*
elif [ -f "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/bin/analog_sticks_ledcontrol_single" ]; then
  exec "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/bin/analog_sticks_ledcontrol_single" $*
fi

echo "No analog_sticks_ledcontrol_single handler for ${QUIRK_DEVICE:-unset device} / ${HW_DEVICE:-unset platform}" >&2
exit 1
