From bc7457eb0fe585204f514685bf01bfa36c8724c8 Mon Sep 17 00:00:00 2001
From: kk <405437445@qq.com>
Date: Mon, 23 Mar 2026 08:53:59 +0800
Subject: [PATCH 1/6] Skip loading hidden systems at startup to improve boot
 performance

Hidden systems configured in HiddenSystems setting are now skipped
during initial system loading. This avoids unnecessary ROM directory
scanning, gamelist parsing, and theme loading for systems the user
has chosen to hide.

When a user unhides a system via the UI, reloadSystems is triggered
and the system is loaded normally.
---
 es-app/src/SystemData.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/es-app/src/SystemData.cpp b/es-app/src/SystemData.cpp
index a8138bd..e5c35f5 100644
--- a/es-app/src/SystemData.cpp
+++ b/es-app/src/SystemData.cpp
@@ -1054,6 +1054,18 @@ SystemData* SystemData::loadSystem(pugi::xml_node system, bool fullMode)
 
 	SystemMetadata md;
 	md.name = system.child("name").text().get();
+
+	// Skip loading hidden systems at startup to improve performance
+	// They will be loaded when user unhides them (triggers reloadSystems)
+	if (fullMode)
+	{
+		auto hiddenSystems = Settings::getInstance()->getHiddenSystems();
+		if (hiddenSystems.find(md.name) != hiddenSystems.cend())
+		{
+			LOG(LogDebug) << "Skipping hidden system: " << md.name;
+			return nullptr;
+		}
+	}
 	md.fullName = system.child("fullname").text().get();
 	md.manufacturer = system.child("manufacturer").text().get();
 	md.releaseYear = Utils::String::toInteger(system.child("release").text().get());
