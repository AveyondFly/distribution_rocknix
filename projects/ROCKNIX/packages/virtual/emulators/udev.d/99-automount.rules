# dont run in "installer" mode
IMPORT{cmdline}="installer"
ENV{installer}=="1", GOTO="exit"

SUBSYSTEM!="block", KERNEL!="mmc*", GOTO="exit"

# Re-evaluate the selected games partition when a card is removed. This must
# be handled before blkid because filesystem properties may already be gone.
ACTION=="remove", ENV{DEVTYPE}=="partition|disk", RUN+="/usr/bin/sh -c '/usr/bin/busybox touch /run/rocknix-games-hotplug; /usr/bin/systemctl restart rocknix-automount.service'", GOTO="exit"

# check for special partitions we dont want mount
IMPORT{builtin}="blkid"
ENV{ID_FS_LABEL}=="EFI|BOOT|Recovery|RECOVERY|SETTINGS|boot|root0|share0", GOTO="exit"

# /dev/mmc* partitions/disk and filesystems only
KERNEL=="mmc*", ENV{DEVTYPE}=="partition|disk", ENV{ID_FS_USAGE}=="filesystem", GOTO="harddisk"
GOTO="exit"

# mount game partitions
LABEL="harddisk"
ACTION=="add", PROGRAM="/usr/bin/sh -c '/usr/bin/grep -E ^/dev/%k\  /proc/mounts || true'", RESULT=="", RUN+="/usr/bin/sh -c '/usr/bin/busybox touch /run/rocknix-games-hotplug; /usr/bin/systemctl restart rocknix-automount.service'"
GOTO="exit"

# Exit
LABEL="exit"
