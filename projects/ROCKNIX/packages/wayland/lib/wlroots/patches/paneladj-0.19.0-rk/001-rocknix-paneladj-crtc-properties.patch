+bool wlr_drm_output_set_paneladj(struct wlr_output *output,
+		const char *property, uint64_t value) {
+	if (!wlr_output_is_drm(output)) {
+		wlr_log(WLR_ERROR, "Cannot set panel adjustment on non-DRM output");
+		return false;
+	}
+
+	if (value > 100) {
+		wlr_log(WLR_ERROR, "Panel adjustment value out of range: %"PRIu64,
+			value);
+		return false;
+	}
+
+	struct wlr_drm_connector *conn = get_drm_connector_from_output(output);
+	if (conn->crtc == NULL) {
+		wlr_drm_conn_log(conn, WLR_ERROR,
+			"Cannot set panel adjustment without an assigned CRTC");
+		return false;
+	}
+
+	uint32_t prop = 0;
+	if (strcmp(property, "brightness") == 0) {
+		prop = conn->crtc->props.brightness;
+	} else if (strcmp(property, "contrast") == 0) {
+		prop = conn->crtc->props.contrast;
+	} else if (strcmp(property, "saturation") == 0) {
+		prop = conn->crtc->props.saturation;
+	} else if (strcmp(property, "hue") == 0) {
+		prop = conn->crtc->props.hue;
+	} else {
+		wlr_drm_conn_log(conn, WLR_ERROR,
+			"Unknown panel adjustment property: %s", property);
+		return false;
+	}
+
+	if (prop == 0) {
+		wlr_drm_conn_log(conn, WLR_ERROR,
+			"CRTC %"PRIu32" lacks panel adjustment property: %s",
+			conn->crtc->id, property);
+		return false;
+	}
+
+	if (drmModeObjectSetProperty(conn->backend->fd, conn->crtc->id,
+			DRM_MODE_OBJECT_CRTC, prop, value) != 0) {
+		wlr_drm_conn_log_errno(conn, WLR_ERROR,
+			"Failed to set panel adjustment property %s to %"PRIu64,
+			property, value);
+		return false;
+	}
+
+	return true;
+}
