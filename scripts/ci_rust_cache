#!/bin/bash

# SPDX-License-Identifier: GPL-2.0
# Manage Rust/Cargo build cache paths for CI.
# Usage:
#   ci_rust_cache restore <cache-base-url> <artifact-prefix>
#   ci_rust_cache archive <build-dir> <output-prefix> [--remove-files]
#   ci_rust_cache artifact-paths <build-dir>

set -e

usage() {
  echo "Usage: ${0##*/} restore <cache-base-url> <artifact-prefix>" >&2
  echo "       ${0##*/} archive <build-dir> <output-prefix> [--remove-files]" >&2
  echo "       ${0##*/} artifact-paths <build-dir>" >&2
  exit 1
}

collect_toolchain_rust_paths() {
  local build="$1"
  local -n _out=$2
  local path

  for path in \
    "${build}/toolchain/bin/rustc" \
    "${build}/toolchain/bin/cargo"
  do
    [ -e "${path}" ] && _out+=("${path}")
  done

  [ -d "${build}/toolchain/lib/rustlib" ] && _out+=("${build}/toolchain/lib/rustlib")

  # rustc is dynamically linked against librustc_driver-*.so in toolchain/lib
  shopt -s nullglob
  for path in "${build}/toolchain/lib"/librustc*.so*; do
    _out+=("${path}")
  done
  shopt -u nullglob
}

collect_artifact_paths() {
  local build="$1"
  local -n _out=$2

  _out=()
  [ -d "${build}" ] || return 0

  shopt -s nullglob
  for path in \
    "${build}/install_pkg/ruffle-sa-"* \
    "${build}/.stamps/rust" \
    "${build}/.stamps/cargo" \
    "${build}/.stamps/ruffle-sa"
  do
    [ -e "${path}" ] && _out+=("${path}")
  done
  shopt -u nullglob

  collect_toolchain_rust_paths "${build}" _out
}

collect_paths() {
  local build="$1"
  local -n _out=$2
  local target_dir pkg_build_dir pkg_name stamp_dir

  _out=()

  [ -d "${build}" ] || return 0

  for path in \
    "${build}/.cargo-home" \
    "${build}/build/rust-"* \
    "${build}/build/cargo-"* \
    "${build}/build/rustc-snapshot-"* \
    "${build}/build/rust-std-snapshot-"* \
    "${build}/build/cargo-snapshot-"* \
    "${build}/.stamps/rust" \
    "${build}/.stamps/cargo"
  do
    [ -e "${path}" ] && _out+=("${path}")
  done

  collect_toolchain_rust_paths "${build}" _out

  for path in "${build}/install_pkg/ruffle-"*; do
    [ -e "${path}" ] && _out+=("${path}")
  done

  while IFS= read -r target_dir; do
    pkg_build_dir="$(dirname "$(dirname "${target_dir}")")"
    _out+=("${pkg_build_dir}")
  done < <(find "${build}/build" -mindepth 2 -maxdepth 2 -type d -name target 2>/dev/null || true)

  for stamp_dir in "${build}/.stamps"/*/; do
    [ -d "${stamp_dir}" ] || continue
    pkg_name="$(basename "${stamp_dir}")"
    case "${pkg_name}" in
      rust|cargo) continue ;;
    esac
    if find "${build}/build/${pkg_name}-"*/ -mindepth 2 -maxdepth 2 -type d -name target 2>/dev/null | grep -q .; then
      _out+=("${stamp_dir%/}")
    fi
  done
}

dedupe_paths() {
  local -n _paths=$1
  local -A seen=()
  local -a unique=()
  local path

  for path in "${_paths[@]}"; do
    [ -n "${path}" ] || continue
    [ -e "${path}" ] || continue
    if [ -z "${seen[${path}]}" ]; then
      seen[${path}]=1
      unique+=("${path}")
    fi
  done

  _paths=("${unique[@]}")
}

cmd_restore() {
  local base="$1"
  local prefix="$2"
  local found_any=0 suffix file url

  [ -n "${base}" ] && [ -n "${prefix}" ] || usage

  for suffix in $(printf "%s\n" {a..z}{a..z}); do
    file="${prefix}${suffix}"
    url="${base}/${file}"

    echo "Trying ${url}"
    if curl -L --fail --silent --show-error -o "${file}" "${url}"; then
      echo "Downloaded ${file}"
      found_any=1
    else
      echo "No more parts found at ${url}"
      break
    fi
  done

  if [ "${found_any}" -eq 0 ]; then
    echo "No rust cache found, skipping."
    return 0
  fi

  cat ${prefix}* > rust-cache.tar
  tar -xf rust-cache.tar || { echo "Extract failed"; rm -f ${prefix}* rust-cache.tar; return 0; }
  rm -f ${prefix}* rust-cache.tar
}

cmd_archive() {
  local build="$1"
  local prefix="$2"
  local remove_files="${3:-}"
  local tar_opts=()
  local -a paths=()

  [ -n "${build}" ] && [ -n "${prefix}" ] || usage

  collect_paths "${build}" paths
  dedupe_paths paths

  if [ ${#paths[@]} -eq 0 ]; then
    echo "No Rust cache paths found under ${build}, skipping archive."
    exit 0
  fi

  echo "Archiving ${#paths[@]} Rust cache path(s):"
  printf '  %s\n' "${paths[@]}"

  if [ "${remove_files}" = "--remove-files" ]; then
    tar_opts+=(--remove-files)
  fi

  tar "${tar_opts[@]}" -cf - "${paths[@]}" | split -b 1900m - "${prefix}"
}

cmd_artifact_paths() {
  local build="$1"
  local -a paths=()

  [ -n "${build}" ] || usage

  collect_artifact_paths "${build}" paths
  dedupe_paths paths

  if [ ${#paths[@]} -eq 0 ]; then
    echo "No ruffle-sa artifact paths found under ${build}." >&2
    exit 1
  fi

  printf '%s\n' "${paths[@]}"
}

case "${1:-}" in
  restore)
    cmd_restore "${@:2:2}"
    ;;
  archive)
    cmd_archive "${@:2}"
    ;;
  artifact-paths)
    cmd_artifact_paths "${2}"
    ;;
  *)
    usage
    ;;
esac
