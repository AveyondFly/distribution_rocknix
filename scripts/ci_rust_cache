#!/bin/bash

# SPDX-License-Identifier: GPL-2.0
# Archive Rust/Cargo build cache paths for CI (emu-standalone job).
# Usage: ci_rust_cache archive <build-dir> <output-prefix>

set -e

usage() {
  echo "Usage: ${0##*/} archive <build-dir> <output-prefix>" >&2
  exit 1
}

collect_paths() {
  local build="$1"
  local -n _out=$2
  local target_dir pkg_build_dir pkg_name stamp_dir

  _out=()

  [ -d "${build}" ] || return 0

  for path in \
    "${build}/.cargo-home" \
    "${build}/build/rust-"* \
    "${build}/build/cargo-"* \
    "${build}/build/rustc-snapshot-"* \
    "${build}/build/rust-std-snapshot-"* \
    "${build}/build/cargo-snapshot-"* \
    "${build}/toolchain/bin/rustc" \
    "${build}/toolchain/bin/cargo" \
    "${build}/toolchain/lib/rustlib" \
    "${build}/.stamps/rust" \
    "${build}/.stamps/cargo"
  do
    [ -e "${path}" ] && _out+=("${path}")
  done

  while IFS= read -r target_dir; do
    pkg_build_dir="$(dirname "$(dirname "${target_dir}")")"
    _out+=("${pkg_build_dir}")
  done < <(find "${build}/build" -mindepth 2 -maxdepth 2 -type d -name target 2>/dev/null || true)

  for stamp_dir in "${build}/.stamps"/*/; do
    [ -d "${stamp_dir}" ] || continue
    pkg_name="$(basename "${stamp_dir}")"
    case "${pkg_name}" in
      rust|cargo) continue ;;
    esac
    if find "${build}/build/${pkg_name}-"*/ -mindepth 2 -maxdepth 2 -type d -name target 2>/dev/null | grep -q .; then
      _out+=("${stamp_dir%/}")
    fi
  done
}

dedupe_paths() {
  local -n _paths=$1
  local -A seen=()
  local -a unique=()
  local path

  for path in "${_paths[@]}"; do
    [ -n "${path}" ] || continue
    [ -e "${path}" ] || continue
    if [ -z "${seen[${path}]}" ]; then
      seen[${path}]=1
      unique+=("${path}")
    fi
  done

  _paths=("${unique[@]}")
}

cmd_archive() {
  local build="$1"
  local prefix="$2"
  local -a paths=()

  [ -n "${build}" ] && [ -n "${prefix}" ] || usage

  collect_paths "${build}" paths
  dedupe_paths paths

  if [ ${#paths[@]} -eq 0 ]; then
    echo "No Rust cache paths found under ${build}, skipping archive."
    exit 0
  fi

  echo "Archiving ${#paths[@]} Rust cache path(s):"
  printf '  %s\n' "${paths[@]}"

  tar --remove-files -cf - "${paths[@]}" | split -b 1900m - "${prefix}"
}

case "${1:-}" in
  archive)
    cmd_archive "${@:2}"
    ;;
  *)
    usage
    ;;
esac
